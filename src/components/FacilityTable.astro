---
import { FACILITIES, facilityStats, pick } from '../data/initiative';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;

const stats = facilityStats();

const facilityLabel: Record<typeof locale, string> = { en: 'facilities', es: 'instalaciones' };
const countryLabel: Record<typeof locale, string> = { en: 'countries', es: 'países' };
const regionLabel: Record<typeof locale, string> = {
  en: 'Partner facilities table; scroll horizontally to see every column',
  es: 'Tabla de instalaciones asociadas; desplázate horizontalmente para ver todas las columnas',
};
const scrollHint: Record<typeof locale, string> = {
  en: 'Scroll horizontally to see websites.',
  es: 'Desplázate horizontalmente para ver los sitios web.',
};

const labels = {
  caption:     { en: 'Partner facilities', es: 'Instalaciones asociadas' },
  institution: { en: 'Institution', es: 'Institución' },
  country:     { en: 'Country', es: 'País' },
  platforms:   { en: 'Platforms', es: 'Plataformas' },
  website:     { en: 'Website', es: 'Sitio web' },
  total:       { en: 'Total', es: 'Total' },
} as const;
---

<p class="facility-scroll-hint content-meta">{scrollHint[locale]}</p>
<div
  class="facility-table-wrapper"
  role="region"
  aria-label={regionLabel[locale]}
  tabindex="0"
>
  <table class="facility-table">
    <caption class="facility-caption">{labels.caption[locale]}</caption>
    <thead>
      <tr>
        <th scope="col" class="col-institution">{labels.institution[locale]}</th>
        <th scope="col" class="col-country">{labels.country[locale]}</th>
        <th scope="col" class="col-platforms">{labels.platforms[locale]}</th>
        <th scope="col" class="col-website">{labels.website[locale]}</th>
      </tr>
    </thead>
    <tbody>
      {FACILITIES.map((facility) => (
        <tr>
          <td class="cell-institution">{facility.institution}</td>
          <td class="cell-country">{pick(facility.country, locale)}</td>
          <td class="cell-platforms">{facility.platforms}</td>
          <td class="cell-website">
            {facility.websites.map((website) => (
              <a href={website.href} target="_blank" rel="noopener noreferrer external">
                {website.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr class="tfoot-row">
        <td class="tfoot-agg mono" colspan="4">
          {labels.total[locale]}: {stats.facilities} {facilityLabel[locale]} · {stats.countries} {countryLabel[locale]}
        </td>
      </tr>
    </tfoot>
  </table>
</div>

<style>
  .facility-scroll-hint {
    display: none;
    margin: 0 0 var(--space-xs);
    color: var(--text-muted);
  }
  .facility-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .facility-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
  }
  .facility-caption {
    caption-side: top;
    text-align: left;
    padding: var(--space-s) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    border-bottom: 1px solid var(--hairline);
    background: var(--bg-inset);
  }
  thead th {
    padding: var(--space-s) var(--space-m);
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    background: var(--bg-inset);
    border-bottom: 1px solid var(--hairline-strong);
    white-space: nowrap;
  }
  tbody tr {
    border-bottom: 1px solid var(--hairline);
  }
  tbody tr:last-child {
    border-bottom: none;
  }
  tbody td {
    padding: var(--space-s) var(--space-m);
    color: var(--text);
    line-height: 1.4;
    vertical-align: top;
  }
  .cell-institution {
    font-weight: 560;
    color: var(--text-strong);
  }
  .cell-country {
    white-space: nowrap;
  }
  .cell-website {
    display: grid;
    gap: 0.35rem;
  }
  .cell-website a {
    color: var(--accent-strong);
    text-underline-offset: 0.16em;
  }
  .tfoot-row {
    background: var(--bg-inset);
    border-top: 1px solid var(--hairline-strong);
  }
  .tfoot-agg {
    padding: var(--space-s) var(--space-m);
    font-size: var(--step--2);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  .facility-table-wrapper:focus-visible {
    outline: var(--focus-ring) solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 48rem) {
    .facility-scroll-hint { display: block; }
    .facility-table { min-width: 48rem; }
  }
  .col-institution { width: 34%; }
  .col-country     { width: 15%; }
  .col-platforms   { width: 29%; }
  .col-website     { width: 22%; }
</style>
