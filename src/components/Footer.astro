---
import { getDict, localePath, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL;

---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <img
        class="footer-emblem"
        src={`${base}media/brand/caligo-emblem-transparent.png`}
        alt=""
        aria-hidden="true"
        width="163"
        height="131"
        loading="lazy"
        decoding="async"
      />
      <div class="footer-brand-text">
        <span class="footer-name">Caligo</span>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>
    </div>

    <a class="btn btn--primary footer-join" href={`${localePath(locale, '/participate')}#join`}>
      {t.join.ctaSecondary}<Icon name="arrow-right" />
    </a>
  </div>

  <div class="container-wide footer-base">
    <p class="muted">© {new Date().getFullYear()} {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    background: var(--bg-raised);
    padding-block: var(--space-m);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    grid-template-columns: 1fr;
  }

  /*
    Footer brand — horizontal lockup: the transparent emblem sits at the
    left, while the name and tagline stack beside it. aria-hidden on the
    emblem keeps screen readers from double-announcing "Caligo".
  */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
  .footer-emblem {
    display: block;
    width: clamp(72px, 8vw, 96px);
    height: auto;
    padding: 0.35rem;
    border-radius: var(--radius);
    object-fit: contain;
    flex: 0 0 auto;
  }
  :global(html[data-mode='dark']) .footer-emblem {
    background: var(--c-warm-050);
  }
  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1 1 12rem;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    line-height: 1.1;
  }
  .footer-tagline {
    margin: 0;
    color: var(--text);
    max-width: 42ch;
    line-height: 1.4;
  }

  .footer-join { justify-self: start; }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
  }
  .footer-base p {
    max-width: 62ch;
  }

  @media (min-width: 46rem) {
    .footer-grid {
      grid-template-columns: 1fr auto;
    }
  }
</style>
