---
/**
 * A compact reading guide that distinguishes evidence from interpretation and
 * proposed work. It is intentionally editorial rather than decorative: no
 * icons, numbered steps or interaction are needed to explain the page logic.
 */
interface GuideItem {
  readonly label: string;
  readonly body: string;
}

interface Props {
  readonly id: string;
  readonly heading: string;
  readonly intro?: string;
  readonly items: readonly GuideItem[];
}

const { id, heading, intro, items } = Astro.props;
const headingId = `${id}-heading`;
---

<section class="editorial-status-section" aria-labelledby={headingId}>
  <div class="container-wide editorial-status-guide">
    <header class="editorial-status-header">
      <h2 id={headingId}>{heading}</h2>
      {intro && <p class="content-body">{intro}</p>}
    </header>

    <dl class="editorial-status-items">
      {items.map((item) => (
        <div class="editorial-status-item">
          <dt class="content-label">{item.label}</dt>
          <dd class="content-meta">{item.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .editorial-status-section {
    padding-block: var(--space-m);
    background: var(--bg-raised);
    border-block: 1px solid var(--hairline);
  }
  .editorial-status-guide {
    display: grid;
    gap: var(--space-m);
  }
  .editorial-status-header {
    max-width: var(--measure);
  }
  .editorial-status-header h2 {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .editorial-status-header p {
    margin: var(--space-xs) 0 0;
  }
  .editorial-status-items {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .editorial-status-item {
    min-width: 0;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--hairline);
  }
  .editorial-status-item dt {
    margin-bottom: var(--space-xs);
    color: var(--accent-strong);
  }
  .editorial-status-item dd {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.5;
  }
  @media (min-width: 52rem) {
    .editorial-status-items {
      grid-template-columns: repeat(var(--guide-columns, 3), minmax(0, 1fr));
      border-bottom: 1px solid var(--hairline);
    }
    .editorial-status-item {
      padding: var(--space-s) var(--space-m);
      border-bottom: 0;
    }
    .editorial-status-item:first-child {
      padding-left: 0;
    }
    .editorial-status-item + .editorial-status-item {
      border-left: 1px solid var(--hairline);
    }
  }
  @media (min-width: 70rem) {
    .editorial-status-guide {
      grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
