---
/**
 * AboutPage — who Caligo is, and who is in it.
 *
 * Absorbed the former /network/ page, which was 236 words of which a
 * quarter re-rendered Home's stats bar and this page's own leadership
 * grid. What was genuinely unique there — the facilities table, the
 * events timeline and the EBP-LatAm note — now sits below Leadership,
 * where a reader looking up "who are these people" already is.
 *
 * Removed rather than moved: Vision and Mission (90 words restating
 * `about.body`'s 45), Strategic objectives (an internal charter), and
 * the "citing another project does not imply a partnership" disclaimer
 * (a legal notice answering a question nobody asked).
 *
 * Sections:
 *   A1  PageHeader — about.title / about.body
 *   A2  Why Caligo — the name, once, on the one page that should carry it
 *   A3  Principles — how the work is shaped
 *   A4  Leadership
 *   A5  Partner facilities
 *   A6  Events
 *   A7  Connections and context
 *   A8  Governance
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import PrincipleGrid from '../PrincipleGrid.astro';
import LeadershipGrid from '../LeadershipGrid.astro';
import FacilityTable from '../FacilityTable.astro';
import Timeline from '../Timeline.astro';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const a = t.about;
const h = t.home;
---

<Base locale={locale} title={a.metaTitle} description={a.metaDescription} page="/about">

  <!-- A1 — Header -->
  <PageHeader eyebrow={t.nav.about} title={a.title} intro={a.body} />

  <!-- A2 — The name. The former /caligo/ page said this in 667 words. -->
  <section class="section section--tight section--panel" aria-labelledby="about-name">
    <div class="container-wide prose-column">
      <h2 id="about-name" class="section-heading">{a.name.heading}</h2>
      <div class="prose-block">
        {a.name.body.map((para) => (
          <p class="prose-para">{para}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- A3 — Principles -->
  <section class="section section--tight" aria-labelledby="about-principles">
    <div class="container-wide visual-section">
      <p class="section-eyebrow mono">{h.pillars.eyebrow}</p>
      <h2 id="about-principles" class="section-heading">{h.pillars.title}</h2>
      <PrincipleGrid locale={locale} />
    </div>
  </section>

  <!-- A4 — Leadership -->
  <section class="section section--tight section--panel" aria-labelledby="about-leadership">
    <div class="container-wide visual-section">
      <h2 id="about-leadership" class="section-heading">{a.leadership.heading}</h2>
      <p class="prose-para">{a.leadership.intro}</p>
      <LeadershipGrid locale={locale} />
    </div>
  </section>

  <!-- A5 — Partner facilities (from the former /network/) -->
  <section class="section section--tight" aria-labelledby="about-facilities">
    <div class="container-wide visual-section">
      <h2 id="about-facilities" class="section-heading">{a.facilities.heading}</h2>
      <p class="prose-para">{a.facilities.intro}</p>
      <FacilityTable locale={locale} />
    </div>
  </section>

  <!-- A6 — Events (from the former /network/) -->
  <section class="section section--tight section--panel" aria-labelledby="about-events">
    <div class="container-wide prose-column">
      <h2 id="about-events" class="section-heading">{a.events.heading}</h2>
      <p class="prose-para">{a.events.intro}</p>
      <Timeline locale={locale} />
    </div>
  </section>

  <!-- A7 — Connections and context (from the former /network/) -->
  <section class="section section--tight" aria-labelledby="about-positioning">
    <div class="container-wide prose-column">
      <h2 id="about-positioning" class="section-heading">{a.positioning.heading}</h2>
      <p class="prose-para">{a.positioning.body}</p>
    </div>
  </section>

  <!-- A8 — Governance -->
  <section class="section section--tight section--panel" aria-labelledby="about-governance">
    <div class="container-wide prose-column">
      <h2 id="about-governance" class="section-heading">{a.governance.heading}</h2>
      <p class="prose-para">{a.governance.intro}</p>
    </div>
  </section>

</Base>

<style>
  .visual-section > .section-eyebrow,
  .visual-section > .section-heading,
  .visual-section > .prose-para {
    max-width: var(--measure);
  }

  /* ---- Section rhythm ---- */
  .section { padding-block: var(--space-xl); }
  .section--tight { padding-block: var(--space-l); }
  .section--panel {
    background: var(--bg-raised);
    border-block: 1px solid var(--hairline);
  }
  .section-eyebrow {
    margin: 0 0 var(--space-s);
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .section-heading {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.012em;
    color: var(--text-strong);
  }

  .prose-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .prose-para {
    margin: 0 0 var(--space-m);
    color: var(--text);
    line-height: 1.65;
  }
  .prose-block .prose-para {
    margin-bottom: 0;
  }
</style>
