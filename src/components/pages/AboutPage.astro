---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import PrincipleGrid from '../PrincipleGrid.astro';
import LeadershipGrid from '../LeadershipGrid.astro';
import FacilityTable from '../FacilityTable.astro';
import { ABOUT_FEEDBACK, ABOUT_LINKS } from '../../data/about-feedback';
import { PARTICIPANTS, facilityStats, pick } from '../../data/initiative';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const page = ABOUT_FEEDBACK;
const facilityTotals = facilityStats();
const facilityIntro = locale === 'en'
  ? `${facilityTotals.facilities} partner facilities in ${facilityTotals.countries} countries provide access to short-read and long-read sequencing, with local expertise for preparing and analysing genomic data.`
  : `${facilityTotals.facilities} instalaciones asociadas en ${facilityTotals.countries} países ofrecen acceso a secuenciación de lecturas cortas y largas, junto con experiencia local para preparar y analizar datos genómicos.`;
---

<Base locale={locale} title={t.about.metaTitle} description={t.about.metaDescription} page="/about">
  <PageHeader title={pick(page.header.title, locale)} intro={pick(page.header.intro, locale)} />

  <section class="section section--panel" aria-labelledby="about-community">
    <div class="container-wide">
      <p class="section-eyebrow content-label">{pick(page.community.eyebrow, locale)}</p>
      <h2 id="about-community" class="section-heading content-heading">{pick(page.community.heading, locale)}</h2>
      <p class="prose-para content-body community-intro">{pick(page.community.body, locale)}</p>
      <dl class="community-metrics">
        {page.community.metrics.map((metric, index) => (
          <div class="community-metric">
            <dt>{pick(metric.label, locale)}</dt>
            <dd>{index === 0 ? PARTICIPANTS.value : metric.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="about-goals">
    <div class="container-wide prose-column">
      <h2 id="about-goals" class="section-heading content-heading">{pick(page.goals.heading, locale)}</h2>
      <div class="prose-block">
        {page.goals.body.map((paragraph) => (
          <p class="prose-para content-body">{pick(paragraph, locale)}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="about-name">
    <div class="container-wide prose-column">
      <h2 id="about-name" class="section-heading content-heading">{pick(page.name.heading, locale)}</h2>
      <div class="prose-block">
        {page.name.body.map((paragraph) => (
          <p class="prose-para content-body">{pick(paragraph, locale)}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-principles">
    <div class="container-wide visual-section">
      <h2 id="about-principles" class="section-heading content-heading">{pick(page.principles.heading, locale)}</h2>
      <PrincipleGrid locale={locale} />
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="about-network">
    <div class="container-wide visual-section network-section">
      <div>
        <h2 id="about-network" class="section-heading content-heading">{pick(page.network.heading, locale)}</h2>
      </div>

      <div class="network-block" aria-labelledby="about-leadership">
        <h3 id="about-leadership" class="subsection-heading content-heading">{pick(page.network.leadershipHeading, locale)}</h3>
        <p class="prose-para content-body">{pick(page.network.leadershipIntro, locale)}</p>
        <LeadershipGrid locale={locale} />
      </div>

      <div class="network-block" aria-labelledby="about-facilities">
        <h3 id="about-facilities" class="subsection-heading content-heading">{pick(page.network.facilitiesHeading, locale)}</h3>
        <p class="prose-para content-body">{facilityIntro}</p>
        <FacilityTable locale={locale} />
      </div>

      <div class="network-block network-block--prose" aria-labelledby="about-relationships">
        <h3 id="about-relationships" class="subsection-heading content-heading">{pick(page.network.relationshipsHeading, locale)}</h3>
        <p class="prose-para content-body">
          {pick(page.network.relationships.beforeEarth, locale)}
          <a href={ABOUT_LINKS.earthBioGenome.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.earthBioGenome.label}</a>
          {pick(page.network.relationships.betweenEarthAndGeno, locale)}
          <a href={ABOUT_LINKS.genoTropics.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.genoTropics.label}</a>
          {pick(page.network.relationships.afterGeno, locale)}
          <a href={ABOUT_LINKS.projectPsyche.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.projectPsyche.label}</a>
          {pick(page.network.relationships.betweenEuropean, locale)}
          <a href={ABOUT_LINKS.lepEu.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.lepEu.label}</a>
          {pick(page.network.relationships.end, locale)}
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-eyebrow {
    margin-bottom: var(--space-s);
  }
  .section-heading {
    margin-bottom: var(--space-m);
  }
  .prose-column,
  .community-intro,
  .network-block--prose {
    max-width: var(--measure);
  }
  .prose-block {
    display: grid;
    gap: var(--space-s);
  }
  .prose-para {
    margin: 0;
  }
  .community-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-l) 0 0;
    border-block: 1px solid var(--hairline-strong);
  }
  .community-metric {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
    gap: var(--space-xs);
    padding: var(--space-m);
  }
  .community-metric:first-child {
    padding-left: 0;
  }
  .community-metric + .community-metric {
    border-left: 1px solid var(--hairline);
  }
  .community-metric dt {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .community-metric dd {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
  }
  .network-section {
    display: grid;
    gap: var(--space-l);
  }
  .network-section > div:first-child .section-heading { margin-bottom: 0; }
  .network-block {
    display: grid;
    gap: var(--space-m);
  }
  .subsection-heading {
    margin: 0;
    font-size: var(--step-1);
  }
  .network-block a {
    color: var(--accent-strong);
    text-underline-offset: 0.16em;
  }
  @media (max-width: 44rem) {
    .community-metrics {
      grid-template-columns: 1fr;
    }
    .community-metric,
    .community-metric:first-child {
      padding-inline: 0;
    }
    .community-metric + .community-metric {
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }
  }
</style>
