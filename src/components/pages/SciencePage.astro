---
/**
 * SciencePage — three questions, in prose, each paired with an image.
 *
 * This page was 3,536 words, 13 <details> elements, 36 citation
 * superscripts, a 15-entry bibliography, a sticky sidebar and five
 * animated figures — and not one photograph. The only <img> tags in the
 * built HTML were the header and footer emblems.
 *
 * The structural problem was not length. Every question was a record
 * with six fixed fields, four of which rendered as identical cells under
 * mono uppercase labels: A NEOTROPICAL EXAMPLE / WHAT EVIDENCE IS NEEDED
 * / ONE STATED BOUNDARY / EVIDENCE AND SOURCES. Twenty-four labelled
 * boxes in a 6×4 grid. That template is what produced six consecutive
 * "cannot X, Y or Z without W" sentences — the first reads as
 * intellectual honesty, the sixth reads as a form somebody was required
 * to fill in. You cannot edit your way out of that while the renderer
 * exists, so the renderer is gone.
 *
 * Sources are author-year hyperlinks in the prose flow. The old
 * superscript system rendered 1–9, 16, 17, 20, 21 and 22 above a
 * bibliography styled `list-style: none` — so a reader clicking "22"
 * landed on an unnumbered row, and 10–15, 18 and 19 appeared nowhere on
 * the page. It had never worked in production.
 *
 * LAYOUT CONTRACT — every block on this page is one of two shapes:
 *
 *   1. prose | image     a text column beside a portrait-ish figure
 *   2. full-width figure  a wide figure spanning the whole container
 *
 * There is deliberately no third shape. The page previously rendered
 * hand-drawn concept diagrams constrained to 46rem, which left a third
 * of the row empty beside them — a half-width block in a full-width row
 * reads as something failing to load.
 *
 * The concept diagrams themselves are gone from this page. Where the
 * source paper had already drawn the thing, we reproduce the paper's own
 * figure: it is the real measurement rather than our paraphrase of it,
 * and both papers are licensed for reuse. ConceptDiagram still serves
 * the Heliconius pilot on /projects/.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import PublishedFigure from '../PublishedFigure.astro';
import ConceptDiagram from '../ConceptDiagram.astro';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const s = t.science;

/*
  Anchors must match `questionAnchors` in HomePage.astro, which renders
  the teaser links into this page.
*/
const anchors = ['chromosomes', 'gene-flow', 'connectivity'] as const;

/** The image beside the prose. */
const questionAside: Record<string, { photo?: string; figure?: 'hybridOriginFigure' }> = {
  chromosomes: { photo: 'pilot-heliconius' },
  'gene-flow': { figure: 'hybridOriginFigure' },
  connectivity: { photo: 'pilot-parides' },
};

/*
  The wide figure below the prose, where one exists. Both licences were
  verified against Crossref before use — CC0 for Rueda-M, CC BY 4.0 for
  Rosser — and full provenance sits in the .LICENSE.md beside each image.

  Being readable on PMC is not a licence: Edelman 2019 and Seraphim 2016,
  both cited on this site, are free to read and cannot be reproduced.
*/
const questionWideFigure: Record<string, 'chromosomeFigure' | undefined> = {
  chromosomes: 'chromosomeFigure',
  'gene-flow': undefined,
  connectivity: undefined,
};

/*
  Where the paper's own figure is a research figure rather than an
  explanatory one, we draw it instead. Rosser Fig 3 shows the same claim
  as this diagram and shows it measured — but it is four F_ST tracks, an
  eight-item legend and a species-tree/introgression-tree key, and this
  page exists to pull people toward research rather than to gate it.

  What the diagram takes from Fig 3 is its one transferable idea: put
  each trait AT its chromosome, in a labelled row, instead of listing
  chromosome numbers in a caption the reader has to map back by hand.

  Full width, like the published figures — a wide karyotype in a narrow
  column is unreadable, and a half-width block in a full-width row reads
  as something failing to load.
*/
const questionWideDiagram: Record<string, 'introgression' | undefined> = {
  chromosomes: undefined,
  'gene-flow': 'introgression',
  connectivity: undefined,
};

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';
---

<Base locale={locale} title={s.metaTitle} description={s.metaDescription} page="/science">

  <PageHeader eyebrow={t.nav.science} title={s.title} intro={s.intro} />

  <section class="section" aria-labelledby="questions-heading">
    <div class="container-wide">
      <h2 id="questions-heading" class="sr-only">{s.questionsHeading}</h2>

      {s.questions.map((q, i) => {
        const anchor = anchors[i];
        const aside = questionAside[anchor];
        const wide = questionWideFigure[anchor];
        const wideDiagram = questionWideDiagram[anchor];
        return (
          <article id={anchor} class="question">
            <h3 class="question-heading">{q.heading}</h3>

            <div class="split">
              <div class="split-prose">
                {q.answer.map((para) => <p>{para}</p>)}
                <p class="question-sources">
                  <span class="question-sources-label">{sourcesLabel}: </span>
                  {q.sources.map((src, n) => (
                    <>
                      {n > 0 && ' · '}
                      <a href={src.url} rel="external noopener">{src.label}</a>
                    </>
                  ))}
                </p>
              </div>

              <div class="split-figure">
                {aside.photo && (
                  <MediaCandidateViewer moduleId={aside.photo} locale={locale} aspectRatio="4 / 3" />
                )}
                {aside.figure && <PublishedFigure locale={locale} {...s[aside.figure]} />}
              </div>
            </div>

            {wide && (
              <div class="wide-figure">
                <PublishedFigure locale={locale} {...s[wide]} />
              </div>
            )}

            {wideDiagram && (
              <div class="wide-figure">
                <ConceptDiagram locale={locale} kind={wideDiagram} context="science" />
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="evidence-heading">
    <div class="container-wide split">
      <div class="split-prose">
        <h2 id="evidence-heading" class="section-heading">{s.evidence.heading}</h2>
        {s.evidence.body.map((para) => <p class="prose-para">{para}</p>)}
      </div>
      <div class="split-figure">
        <MediaCandidateViewer moduleId="journey-4-sequence" locale={locale} aspectRatio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ethics-heading">
    <div class="container-wide split">
      <div class="split-prose">
        <h2 id="ethics-heading" class="section-heading">{s.ethics.heading}</h2>
        {s.ethics.body.map((para) => <p class="prose-para">{para}</p>)}
      </div>
      <div class="split-figure">
        <MediaCandidateViewer moduleId="journey-2-provenance" locale={locale} aspectRatio="4 / 3" />
      </div>
    </div>
  </section>

</Base>

<style>
  .section { padding-block: var(--space-xl); }
  .section--panel {
    background: var(--bg-raised);
    border-block: 1px solid var(--hairline);
  }
  .section-heading {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.012em;
    color: var(--text-strong);
    max-width: 28ch;
  }
  .prose-para {
    margin: 0 0 var(--space-m);
    color: var(--text);
    line-height: 1.65;
    max-width: var(--measure);
  }
  .prose-para:last-child { margin-bottom: 0; }

  /* ---- Shape 1: prose beside an image ----
     One rule, used by every block on the page. The image column carries
     the figure's own caption and credit, so it is never a bare picture. */
  .split {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .split { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
  }
  .split-prose > p {
    margin: 0 0 var(--space-m);
    color: var(--text);
    line-height: 1.65;
    max-width: var(--measure);
  }
  .split-prose > p:last-child { margin-bottom: 0; }
  .split-figure { min-width: 0; }

  /* ---- Shape 2: a wide figure on its own row ----
     Full container width, deliberately. These are dense research figures
     with chromosome-scale labels; below roughly 900px they stop being
     readable and become decoration. */
  .wide-figure {
    margin-top: var(--space-l);
    max-width: none;
  }

  /* ---- Questions ---- */
  .question {
    scroll-margin-top: 5rem;
    padding-block: var(--space-l);
  }
  .question + .question {
    border-top: 1px solid var(--hairline);
  }
  .question-heading {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--text-strong);
    max-width: 34ch;
  }

  .question-sources {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .question-sources-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .question-sources a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--hairline-strong);
  }
  .question-sources a:hover { text-decoration-color: currentColor; }
</style>
