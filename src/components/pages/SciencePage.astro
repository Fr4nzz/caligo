---
/**
 * SciencePage — three questions, in prose.
 *
 * This page was 3,536 words, 13 <details> elements, 36 citation
 * superscripts, a 15-entry bibliography, a sticky sidebar and five
 * animated figures — and not one photograph. The only <img> tags in the
 * built HTML were the header and footer emblems.
 *
 * The structural problem was not length. Every question was a record
 * with six fixed fields, four of which rendered as identical cells under
 * mono uppercase labels: A NEOTROPICAL EXAMPLE / WHAT EVIDENCE IS NEEDED
 * / ONE STATED BOUNDARY / EVIDENCE AND SOURCES. Twenty-four labelled
 * boxes in a 6×4 grid. That template is what produced six consecutive
 * "cannot X, Y or Z without W" sentences — the first reads as
 * intellectual honesty, the sixth reads as a form somebody was required
 * to fill in. You cannot edit your way out of that while the renderer
 * exists, so the renderer is gone.
 *
 * Three questions survive, as flowing prose with a photograph and a
 * plain source line. Cut: species boundaries (a 2018 moth-genera
 * reshuffle), seasonal movement (a block that existed to report a
 * preprint and then withdraw confidence in it), the "three scales of
 * genetic evidence" section (which taught the same three tiers as the
 * table directly above it, once as a table and once as an animation),
 * and the 12-item metadata field list, which is a data-management SOP
 * and belongs in a partner handbook.
 *
 * Sources are author-year hyperlinks in the prose flow. The old
 * superscript system rendered 1–9, 16, 17, 20, 21 and 22 above a
 * bibliography styled `list-style: none` — so a reader clicking "22"
 * landed on an unnumbered row, and 10–15, 18 and 19 appeared nowhere on
 * the page. It had never worked in production.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import ConceptDiagram from '../ConceptDiagram.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const s = t.science;

/*
  Anchors must match `questionAnchors` in HomePage.astro, which renders
  the teaser links into this page.
*/
const anchors = ['chromosomes', 'gene-flow', 'connectivity'] as const;

/*
  A figure only where it teaches something the paragraph beside it
  cannot. The holocentric contrast does; so does the karyotype showing
  where introgressed regions actually landed. The third question gets a
  photograph of the animal instead — it is about a real population in a
  real place, and the previous figure attached to it illustrated hybrid
  speciation, which is the subject of the question above.
*/
const questionDiagram: Record<string, 'chromosome' | 'introgression' | undefined> = {
  chromosomes: 'chromosome',
  'gene-flow': 'introgression',
  connectivity: undefined,
};
const questionPhoto: Record<string, string | undefined> = {
  chromosomes: 'pilot-heliconius',
  'gene-flow': undefined,
  connectivity: 'pilot-parides',
};

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';
---

<Base locale={locale} title={s.metaTitle} description={s.metaDescription} page="/science">

  <PageHeader eyebrow={t.nav.science} title={s.title} intro={s.intro} />

  <section class="section" aria-labelledby="questions-heading">
    <div class="container-wide">
      <h2 id="questions-heading" class="sr-only">{s.questionsHeading}</h2>

      {s.questions.map((q, i) => {
        const anchor = anchors[i];
        const diagram = questionDiagram[anchor];
        const photo = questionPhoto[anchor];
        return (
          <article id={anchor} class="question">
            <h3 class="question-heading">{q.heading}</h3>

            <div class="question-body">
              <div class="question-prose">
                {q.answer.map((para) => <p>{para}</p>)}
                <p class="question-sources">
                  <span class="question-sources-label">{sourcesLabel}: </span>
                  {q.sources.map((src, n) => (
                    <>
                      {n > 0 && ' · '}
                      <a href={src.url} rel="external noopener">{src.label}</a>
                    </>
                  ))}
                </p>
              </div>

              {photo && (
                <div class="question-figure">
                  <MediaCandidateViewer moduleId={photo} locale={locale} aspectRatio="4 / 3" />
                </div>
              )}
            </div>

            {diagram && (
              <div class="question-diagram">
                <ConceptDiagram locale={locale} kind={diagram} context="science" />
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="evidence-heading">
    <div class="container-wide prose-column">
      <h2 id="evidence-heading" class="section-heading">{s.evidence.heading}</h2>
      {s.evidence.body.map((para) => <p class="prose-para">{para}</p>)}
    </div>
  </section>

  <section class="section" aria-labelledby="ethics-heading">
    <div class="container-wide ethics-layout">
      <div class="ethics-prose">
        <h2 id="ethics-heading" class="section-heading">{s.ethics.heading}</h2>
        {s.ethics.body.map((para) => <p class="prose-para">{para}</p>)}
      </div>
      <div class="ethics-figure">
        <MediaCandidateViewer moduleId="journey-2-provenance" locale={locale} aspectRatio="4 / 3" />
      </div>
    </div>
  </section>

</Base>

<style>
  .section { padding-block: var(--space-xl); }
  .section--panel {
    background: var(--bg-raised);
    border-block: 1px solid var(--hairline);
  }
  .section-heading {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.012em;
    color: var(--text-strong);
    max-width: 28ch;
  }
  .prose-para {
    margin: 0 0 var(--space-m);
    color: var(--text);
    line-height: 1.65;
    max-width: var(--measure);
  }

  /* ---- Questions ---- */
  .question {
    scroll-margin-top: 5rem;
    padding-block: var(--space-l);
  }
  .question + .question {
    border-top: 1px solid var(--hairline);
  }
  .question-heading {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--text-strong);
    max-width: 34ch;
  }
  .question-body {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    align-items: start;
  }
  /* The photograph sits beside the prose rather than above it, so the
     reading measure stays intact on wide screens. */
  @media (min-width: 60rem) {
    .question-body:has(.question-figure) {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }
  .question-prose > p {
    margin: 0 0 var(--space-m);
    color: var(--text);
    line-height: 1.65;
    max-width: var(--measure);
  }
  .question-prose > p:last-child { margin-bottom: 0; }
  .question-figure { min-width: 0; }
  .question-diagram { margin-top: var(--space-l); }

  .question-sources {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .question-sources-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .question-sources a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--hairline-strong);
  }
  .question-sources a:hover { text-decoration-color: currentColor; }

  /* ---- Ethics ---- */
  .ethics-layout {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .ethics-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }
  .ethics-figure { min-width: 0; }
</style>
