---
import Base from '../../layouts/Base.astro';
import CopyEmail from '../CopyEmail.astro';
import DiscordButton from '../DiscordButton.astro';
import { LINKS } from '../../data/content';
import HeroMedia from '../HeroMedia.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import Icon from '../Icon.astro';
import CommunityStats from '../CommunityStats.astro';
import Timeline from '../Timeline.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { PILOTS, getMedia } from '../../data/records';

const pilotScienceAnchors = [
  'chromosomes',
  'connectivity',
  'soybean-movement-resistance',
  'panacea-migration',
] as const;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const h = t.home;
const base = import.meta.env.BASE_URL;

const heroMedia = getMedia('hero-caligo-tambopata');
if (!heroMedia) {
  throw new Error("HomePage: missing 'hero-caligo-tambopata' media record.");
}

const desktopSrcset = [
  { width: 800,  height: 451,  path: `${base}media/hero/caligo-tambopata-800w.jpg` },
  { width: 1200, height: 677,  path: `${base}media/hero/caligo-tambopata-1200w.jpg` },
  { width: 1600, height: 902,  path: `${base}media/hero/caligo-tambopata-1600w.jpg` },
  { width: 2400, height: 1354, path: `${base}media/hero/caligo-tambopata-2400w.jpg` },
] as const;
const publishedPilots = PILOTS.filter((pilot) => pilot.publish);
if (publishedPilots.length !== h.researchCards.length) {
  throw new Error('HomePage: each published pilot needs one evidence-to-pilot card.');
}
---

<Base locale={locale} title={h.metaTitle} description={h.metaDescription} page="/">

  <!-- ====================== H1 — Cinematic hero ====================== -->
  <section id="overview" class="hero-cinematic" aria-labelledby="hero-title">
    <span id="h1" hidden aria-hidden="true" data-legacy-anchor="h1" />
    <div class="hero-media-frame">
      <HeroMedia
        mediaId="hero-caligo-tambopata"
        locale={locale}
        kind="photo"
        desktopSrcset={desktopSrcset}
        hideCaption
      />
    </div>

    <div class="hero-overlay">
      <div class="container-wide hero-overlay-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow mono">{h.hero.kicker}</p>
          <h1 id="hero-title" class="hero-title">{h.hero.title}{' '}<em>{h.hero.focus}</em></h1>
          <p class="hero-tagline">{h.hero.body}</p>
          <div class="hero-actions">
            <a class="btn hero-btn-primary" href={localePath(locale, '/science')}>
              {h.hero.scienceAction}<Icon name="arrow-right" />
            </a>
            <a class="btn hero-btn-ghost" href={localePath(locale, '/projects')}>
              {h.hero.projectsAction}
            </a>
          </div>
        </div>
      </div>
    </div>

    <p class="hero-attribution mono">
      {heroMedia.credit[locale]}
      {' · '}
      <a href={heroMedia.sourceItemPage} rel="external noopener">{t.mediaViewer.sourceLinkLabel}</a>
      {' · '}
      <a href={heroMedia.licenceUrl} rel="license external noopener">{heroMedia.licence}</a>
    </p>
  </section>

  <!-- ==================== STAT BAR — network metrics ==================== -->
  <section class="section section--tight stat-bar-section">
    <div class="container-wide">
      <CommunityStats locale={locale} />
    </div>
  </section>

  <!-- ====================== H2 — Why butterflies and moths ======================
       Psyche's second homepage section. This copy already existed under
       `home.intro` but was rendered on /about/ instead, so the homepage
       never answered "why this group of animals" at all.
  -->
  <section id="why-lepidoptera" class="section" aria-labelledby="h2b-title">
    <div class="container-wide intro-layout">
      <div class="intro-copy">
      <p class="section-eyebrow mono">{h.intro.eyebrow}</p>
      <h2 id="h2b-title">{h.intro.title}</h2>
      {h.intro.body.map((para) => <p class="lead">{para}</p>)}
      <a class="text-link intro-link" href={localePath(locale, '/about')}>{t.cta.readVision}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- ====================== H3 — What Caligo is building ====================== -->
  <section id="building" class="section section--panel" aria-labelledby="building-title">
    <div class="container-wide">
      <h2 id="building-title">{h.building.heading}</h2>
      <ol class="building-grid" role="list">
        {h.building.items.map((item, i) => (
          <li class="building-item">
            <span class="item-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ====================== H4 — Published evidence → proposed work ====================== -->
  <section id="questions" class="section" aria-labelledby="h4-title">
    <span id="h4" hidden aria-hidden="true" data-legacy-anchor="h4" />
    <span id="proposed-pilots" hidden aria-hidden="true" />
    <span id="h5" hidden aria-hidden="true" data-legacy-anchor="h5" />
    <div class="container-wide">
      <h2 id="h4-title">{h.questions.heading}</h2>
      <p class="lead">{h.questions.intro}</p>
      <ol class="research-cards" role="list">
        {publishedPilots.map((pilot, i) => {
          const card = h.researchCards[i];
          return (
            <li class="research-card">
              <div class="research-plate-label mono"><span>{String(i + 1).padStart(2, '0')} / {h.researchLabels[i]}</span></div>
              <MediaCandidateViewer
                moduleId={pilot.id}
                locale={locale}
                aspectRatio="3 / 2"
                class="research-card-media"
                captionMode="compact"
                singleImage
              />
              <div class="research-card-content">
                <h3>{card.question}</h3>

                <div class="research-card-links">
                  <a
                    class="text-link"
                    href={`${localePath(locale, '/science')}#${pilotScienceAnchors[i]}`}
                  >
                    {card.scienceLink}<Icon name="arrow-right" />
                  </a>
                  <a
                    class="text-link"
                    href={`${localePath(locale, '/projects')}#${pilot.slug}`}
                  >
                    {card.projectLink}<Icon name="arrow-right" />
                  </a>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ====================== H5 — Recent and upcoming activity ====================== -->
  <section id="activity" class="section section--panel" aria-labelledby="activity-title">
    <div class="container-wide activity-layout">
      <div class="activity-intro">
        <p class="section-eyebrow mono">{h.activity.eyebrow}</p>
        <h2 id="activity-title">{h.activity.heading}</h2>
        <p class="lead">{h.activity.intro}</p>
      </div>
      <Timeline locale={locale} compact />
    </div>
  </section>

  <!-- ====================== H6 — Participate + brand close ====================== -->
  <section id="discover-caligo" class="section section--close" aria-labelledby="h6-title">
    <span id="h6" hidden aria-hidden="true" data-legacy-anchor="h6" />
    <div class="container-wide close-layout">
      <div class="close-copy">
        <h2 id="h6-title">{h.closing.title}</h2>
        <p class="lead close-body">{h.closing.body}</p>
        <div class="close-actions">
          <a class="btn btn--primary" href={LINKS.joinForm} target="_blank" rel="noopener noreferrer">
            {t.join.cta}<Icon name="arrow-right" />
          </a>
          <DiscordButton locale={locale} />
          <CopyEmail locale={locale} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Scroll margins for semantic + legacy anchors ---- */
  #overview, #from-organism-to-genome, #building,
  #questions, #proposed-pilots, #activity, #discover-caligo,
  #h1, #h2, #h3, #h4, #h5, #h6 { scroll-margin-top: 5rem; }

  /* The stat bar and the introduction share one background, so they need
     only the introduction's top gap. The following priority panel changes
     colour, so retain a smaller closing gap before that visible boundary. */
  .stat-bar-section {
    padding-bottom: 0;
  }
  #why-lepidoptera {
    padding-bottom: var(--space-l);
  }

  /* ---- H1 Cinematic hero ---- */
  .hero-cinematic {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(34rem, 56.42vw, 48rem);
    background: #000;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media-frame :global(.hero-media) {
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .hero-media-frame :global(.hero-media picture),
  .hero-media-frame :global(.hero-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .hero-overlay {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2rem,6vh,4rem) clamp(2.5rem,8vh,5rem);
  }
  .hero-overlay-inner { width: min(100% - 2.5rem, var(--container-wide)); }
  .hero-copy {
    max-width: 40rem;
    margin-left: auto;
    color: #F6F7F3;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, #F6F7F3 78%, transparent);
    text-shadow: 0 1px 6px rgba(0,0,0,0.45);
  }
  .hero-title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.3vw, 3.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #F6F7F3;
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 1px 16px rgba(0,0,0,0.45);
  }
  .hero-tagline {
    margin-top: var(--space-m);
    max-width: 44ch;
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.5;
    color: color-mix(in oklab, #F6F7F3 92%, transparent);
    text-shadow: 0 1px 12px rgba(0,0,0,0.5);
  }
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .hero-btn-primary {
    background: #F6F7F3;
    color: #262524;
    border-color: transparent;
  }
  .hero-btn-primary:hover { background: #FFFFFF; color: #1a1a1a; }
  .hero-btn-ghost {
    background: transparent;
    color: #F6F7F3;
    border: 1px solid color-mix(in oklab, #F6F7F3 45%, transparent);
  }
  .hero-btn-ghost:hover {
    background: color-mix(in oklab, #F6F7F3 12%, transparent);
    border-color: #F6F7F3;
    color: #F6F7F3;
  }
  .hero-attribution {
    position: absolute;
    z-index: 3;
    bottom: 0.75rem;
    right: clamp(1rem, 3vw, 1.6rem);
    margin: 0;
    max-width: 44ch;
    text-align: right;
    font-size: 0.75rem;
    line-height: 1.4;
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    pointer-events: auto;
  }
  .hero-attribution a {
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, #F6F7F3 30%, transparent);
    text-underline-offset: 0.15em;
  }
  .hero-attribution a:hover { color: #F6F7F3; text-decoration-color: currentColor; }
  @media (min-width: 60.001rem) {
    /*
      Shift the photograph left so the butterfly's head clears the text
      column. The source is 2400x1354 (1.77) and the hero renders at almost
      exactly that aspect, so `object-fit: cover` crops vertically and
      `object-position` has no horizontal room to pan — moving the subject
      requires actually widening the rendered image and pulling it left.
      12% is enough to clear the head at every desktop width without
      cropping into the wing pattern.
    */
    .hero-media-frame :global(.hero-media img) {
      width: 112%;
      max-width: none;
      margin-left: -12%;
    }

    /* Start beyond the specimen; use the remaining dark field for copy. */
    .hero-overlay-inner {
      width: 100%;
      margin-inline: 0;
      padding-inline: 60% clamp(1.25rem, 3vw, 4rem);
    }
    .hero-copy {
      max-width: none;
      margin-left: 0;
    }
  }
  @media (max-width: 60rem) {
    /* Mobile hero — translate the desktop's horizontal composition into a
       vertical one: photograph first, then a dedicated dark copy field. */
    .hero-cinematic {
      min-height: auto;
      background: #000;
    }
    .hero-media-frame {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 2400 / 1354;
    }
    .hero-overlay {
      min-height: auto;
      align-items: flex-start;
      padding-block: 0 1rem;
    }
    .hero-copy {
      max-width: 100%;
      margin-left: 0;
    }
    .hero-eyebrow {
      font-size: 0.68rem;
      line-height: 1.4;
    }
    .hero-title {
      margin-top: 0.55rem;
      max-width: 20ch;
      font-size: clamp(1.75rem, 7.2vw, 2.15rem);
      line-height: 1.06;
      text-wrap: pretty;
    }
    .hero-tagline {
      margin-top: 0.9rem;
      max-width: 38ch;
      font-size: 0.94rem;
      line-height: 1.48;
    }
    .hero-actions {
      margin-top: 1.1rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .hero-actions .btn {
      width: 100%;
      min-height: 2.8rem;
      justify-content: space-between;
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
    }
    .hero-attribution {
      position: relative;
      inset: auto;
      margin: 0;
      padding: 0 1rem 0.85rem;
      max-width: none;
      text-align: left;
      font-size: 0.72rem;
      line-height: 1.4;
      color: rgba(246,247,243,0.8);
    }
  }

  /* ---- Common section rhythm ---- */
  .section h2 {
    max-width: 32ch;
    font-size: clamp(1.75rem, 1.55rem + 0.8vw, 2.25rem);
  }
  .section .lead { max-width: var(--measure); }
  .section .lead,
  .building-item p {
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    line-height: 1.55;
  }
  .section-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---- H3 Initiative priorities ---- */
  .building-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--hairline-strong);
  }
  .building-item {
    min-width: 0;
    padding: var(--space-m) var(--space-m) var(--space-m) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .building-item:nth-child(even) {
    padding-left: var(--space-m);
    border-left: 1px solid var(--hairline);
  }
  .item-index {
    display: block;
    margin-bottom: var(--space-s);
    color: var(--accent-strong);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }
  .building-item h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    letter-spacing: -0.006em;
  }
  .building-item p {
    margin: var(--space-xs) 0 0;
    color: var(--text-muted);
  }
  @media (max-width: 48rem) {
    .building-grid {
      grid-template-columns: 1fr;
    }
    .building-item,
    .building-item:nth-child(even) {
      padding: var(--space-m) 0;
      border-left: 0;
      border-bottom: 1px solid var(--hairline);
    }
    .building-item:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
  }

  /* ---- Published evidence → proposed project cards ---- */
  .research-cards {
    list-style: none;
    padding: 0;
    max-width: 74rem;
    margin: var(--space-l) auto 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl) var(--space-l);
  }
  /*
    Match the original pilot-card layout: two columns as soon as there is
    enough room for readable cards. Waiting until 58rem made each item
    become an oversized full-width panel on common laptop/zoomed views.
  */
  @media (min-width: 44rem) {
    .research-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .research-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-panel);
  }
  .research-card :global(.media-candidate-viewer) {
    margin: 0;
  }
  .research-card :global(.mcv-stage) {
    border-radius: 0;
  }
  .research-card-content {
    flex: 1;
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .research-card h3 {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.04rem, 0.98rem + 0.3vw, 1.22rem);
    line-height: 1.2;
    color: var(--text-strong);
  }
  .research-card-links {
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-xs);
  }
  .research-card-links .text-link {
    width: fit-content;
    line-height: 1.35;
  }
  .research-card-links :global(svg) {
    flex: none;
  }

  /* ---- H5 Current activity ---- */
  .activity-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.6fr);
    gap: clamp(var(--space-l), 5vw, var(--space-2xl));
    align-items: start;
  }
  .activity-intro > * + * {
    margin-top: var(--space-m);
  }
  .activity-intro .section-eyebrow + h2 {
    margin-top: var(--space-s);
  }
  @media (max-width: 48rem) {
    .activity-layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  /* ---- H6 Participate + brand close ---- */
  .section--close {
    background: var(--bg-inset);
  }
  .close-layout {
    display: block;
  }
  /* This block sits inside .close-layout, not directly in .container-wide,
     so the global section rhythm does not reach it. Restate it locally
     rather than leave the heading flush against its paragraph. */
  .close-copy { min-width: 0; }
  .close-copy > * + * { margin-top: var(--space-m); }
  .close-body { max-width: var(--measure); }
  .close-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .hero-title { font-size: clamp(2.2rem, 3.9vw, 4.25rem); font-weight: 460; letter-spacing: -.045em; }
  .hero-title em { display: block; margin-top: .18em; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -.035em; line-height: 1.08; }
  .hero-overlay { align-items: center; }
  .hero-copy { padding-bottom: 1rem; }
  .hero-actions { gap: .75rem; }
  .hero-actions .btn { border-radius: 3px; }
  .hero-btn-ghost { border-color: transparent; padding-inline: 0; text-decoration: underline; text-underline-offset: .4em; }
  .hero-attribution { font-family: var(--font-body); max-width: 48ch; }
  .intro-layout { display: grid; grid-template-columns: 1fr; }
  .intro-copy > * + * { margin-top: var(--space-m); }
  .intro-copy h2 { max-width: 25ch; }
  @media (min-width: 60rem) {
    .intro-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); column-gap: clamp(1.5rem, 3vw, 3rem); position: relative; }
    .intro-copy::after { content: ''; position: absolute; inset-block: 0; left: calc((100% - clamp(1.5rem, 3vw, 3rem)) / 2.3 + clamp(1.5rem, 3vw, 3rem) / 2); width: 1px; background: var(--hairline); }
    .intro-copy .section-eyebrow, .intro-copy h2, .intro-copy .intro-link { grid-column: 1; }
    .intro-copy .lead { grid-column: 2; }
    .intro-copy .lead:first-of-type { grid-row: 1 / 3; margin-top: 0; }
    .intro-copy .lead:last-of-type { grid-row: 3 / 5; }
    .intro-copy .intro-link { grid-row: 3; align-self: start; }
  }
  .intro-link { margin-top: var(--space-m); }
  .research-plate-label { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem var(--space-m); border-bottom: 1px solid var(--hairline); color: var(--text-muted); text-transform: uppercase; letter-spacing: .09em; font-size: .73rem; }
  .research-card :global(.mcv-stage) { border-radius: 2px; }
  .research-card h3 { font-size: clamp(1.15rem, 1rem + .45vw, 1.4rem); font-weight: 500; line-height: 1.3; max-width: 34ch; }
  .research-card-links .text-link { font-size: .88rem; }
  .research-card-links .text-link:last-child { color: var(--text-muted); }
  .section--close { border-top: 1px solid var(--hairline); background: var(--bg); }
  .close-copy h2 { max-width: 25ch; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 400; line-height: 1.15; }
  @media (max-width: 60rem) { .hero-title { font-size: clamp(2rem, 5vw, 3rem); max-width: 24ch; } .hero-copy { padding-block: 1.25rem; } .hero-overlay { padding-bottom: .5rem; } .hero-btn-ghost { padding-inline: 1rem; } }
  @media (max-width: 48rem) { .intro-layout { grid-template-columns: 1fr; gap: 2rem; } .research-cards { gap: 2rem; } }
</style>
