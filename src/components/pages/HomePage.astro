---
/**
 * HomePage — what Caligo is, why it matters, and how to join.
 *
 * Modules in order:
 *   H1  Cinematic hero (full-bleed photo + overlay copy).
 *   —   Stat bar — the cheapest credibility on the page.
 *   H2  Why butterflies and moths.
 *   H3  Four questions — teaser links to /science#.
 *   H4  Four proposed pilots — 2×2 cards.
 *   H5  Participate.
 *
 * The six-step "From organism to genome" section used to sit between the
 * principles and the questions. It was ~390 words — a third of the page —
 * teaching assembly and Hi-C curation to a visitor who had not yet been
 * told why the project is worth their attention. It also carried three
 * animated diagrams and seven image-credit disclosures. Project Psyche
 * has published genomes and still does not explain assembly on its
 * homepage. That material belongs on /science/, where the readers who
 * want it already are.
 */
import Base from '../../layouts/Base.astro';
import HeroMedia from '../HeroMedia.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import Icon from '../Icon.astro';
import CommunityStats from '../CommunityStats.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { PILOTS, getMedia } from '../../data/records';
import { discordInviteUrl } from '../../config/site';

/**
 * Science-page anchors for the question teasers, in the same order as
 * `t.science.questions[]` (single source of truth). The array length is
 * also what Home renders, so adding a question on Science does not
 * silently add an unanchored row here.
 */
const questionAnchors = ['chromosomes', 'gene-flow', 'connectivity', 'museum-collections'] as const;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const h = t.home;
const base = import.meta.env.BASE_URL;

const heroMedia = getMedia('hero-caligo-tambopata');
if (!heroMedia) {
  throw new Error("HomePage: missing 'hero-caligo-tambopata' media record.");
}

const desktopSrcset = [
  { width: 800,  height: 451,  path: `${base}media/hero/caligo-tambopata-800w.jpg` },
  { width: 1200, height: 677,  path: `${base}media/hero/caligo-tambopata-1200w.jpg` },
  { width: 1600, height: 902,  path: `${base}media/hero/caligo-tambopata-1600w.jpg` },
  { width: 2400, height: 1354, path: `${base}media/hero/caligo-tambopata-2400w.jpg` },
] as const;
const publishedPilots = PILOTS.filter((p) => p.publish);

---

<Base locale={locale} title={h.metaTitle} description={h.metaDescription} page="/">

  <!-- ====================== H1 — Cinematic hero ====================== -->
  <section id="overview" class="hero-cinematic" aria-labelledby="hero-title">
    <span id="h1" hidden aria-hidden="true" data-legacy-anchor="h1" />
    <div class="hero-media-frame">
      <HeroMedia
        mediaId="hero-caligo-tambopata"
        locale={locale}
        kind="photo"
        desktopSrcset={desktopSrcset}
        hideCaption
      />
    </div>

    <div class="hero-overlay">
      <div class="container-wide hero-overlay-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow mono">{h.hero.kicker}</p>
          <h1 id="hero-title" class="hero-title">{h.hero.title}</h1>
          <p class="hero-tagline">{h.hero.body}</p>
          <div class="hero-actions">
            <a class="btn hero-btn-primary" href={localePath(locale, '/projects')}>
              {t.cta.seeProposedPilots}<Icon name="arrow-right" />
            </a>
            <a class="btn hero-btn-ghost" href={localePath(locale, '/science')}>
              {t.cta.exploreScience}
            </a>
          </div>
        </div>
      </div>
    </div>

    <p class="hero-attribution mono">
      {heroMedia.credit[locale]}
      {' · '}
      <a href={heroMedia.sourceItemPage} rel="external noopener">{t.mediaViewer.sourceLinkLabel}</a>
      {' · '}
      <a href={heroMedia.licenceUrl} rel="license external noopener">{heroMedia.licence}</a>
    </p>
  </section>

  <!-- ==================== STAT BAR — network metrics ==================== -->
  <section class="section section--tight stat-bar-section">
    <div class="container-wide">
      <CommunityStats locale={locale} />
    </div>
  </section>

  <!-- ====================== H2 — Why butterflies and moths ======================
       Psyche's second homepage section. This copy already existed under
       `home.intro` but was rendered on /about/ instead, so the homepage
       never answered "why this group of animals" at all.
  -->
  <section id="why-lepidoptera" class="section" aria-labelledby="h2b-title">
    <div class="container-wide">
      <p class="section-eyebrow mono">{h.intro.eyebrow}</p>
      <h2 id="h2b-title">{h.intro.title}</h2>
      {h.intro.body.map((para) => <p class="lead">{para}</p>)}
    </div>
  </section>

  <!-- ====================== H3 — Questions worth following ======================
       Home renders the question headings only; the answers live on Science.
       We iterate `t.science.questions` so the two pages stay in lockstep by
       construction — no duplicated question copy.
  -->
  <section id="questions" class="section" aria-labelledby="h4-title">
    <span id="h4" hidden aria-hidden="true" data-legacy-anchor="h4" />
    <div class="container-wide">
      <h2 id="h4-title">{h.questions.heading}</h2>
      <p class="lead">{h.questions.intro}</p>
      <ol class="question-teasers" role="list">
        {t.science.questions.slice(0, questionAnchors.length).map((q, i) => (
          <li class="question-teaser">
            <a
              class="question-teaser-link"
              href={`${localePath(locale, '/science')}#${questionAnchors[i] ?? ''}`}
            >
              <span class="question-teaser-index mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="question-teaser-text">{q.heading}</span>
              <span class="question-teaser-cta mono">{t.common.exploreQuestion ?? (locale === 'es' ? 'Explora esta pregunta' : 'Explore this question')}</span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ====================== H4 — Four proposed pilots (2×2 compact cards) ====================== -->
  <section id="proposed-pilots" class="section section--panel" aria-labelledby="h5-title">
    <span id="h5" hidden aria-hidden="true" data-legacy-anchor="h5" />
    <div class="container-wide">
      <h2 id="h5-title">{h.pilotsTeaser.heading}</h2>
      <p class="lead">{h.pilotsTeaser.intro}</p>

      <!--
        Home pilot cards are hooks: image, heading, taxon. The status pill
        ("Proposed pilot project") repeated a phrase already in the section
        heading and in the page title, and the separate "Explore this pilot
        project →" line duplicated the heading link directly above it.
      -->
      <ol class="pilot-cards" aria-label={h.pilotsTeaser.heading}>
        {publishedPilots.map((pilot) => (
          <li class="pilot-card" id={`preview-${pilot.slug}`}>
            <div class="pilot-card-media">
              <MediaCandidateViewer
                moduleId={pilot.id}
                locale={locale}
                aspectRatio="4 / 3"
              />
            </div>
            <div class="pilot-card-content">
              <h3 class="pilot-card-heading">
                <a
                  class="pilot-card-heading-link"
                  href={`${localePath(locale, '/projects')}#${pilot.slug}`}
                >
                  {pilot.heading[locale]}
                </a>
              </h3>
              {pilot.taxon && (
                <p class="pilot-card-taxon mono"><em>{pilot.taxon}</em></p>
              )}
            </div>
          </li>
        ))}
      </ol>

      <p class="pilots-cta">
        <a class="text-link" href={localePath(locale, '/projects')}>
          {t.cta.seeProposedPilots}<Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- ====================== H5 — Participate + brand close ====================== -->
  <section id="discover-caligo" class="section section--close" aria-labelledby="h6-title">
    <span id="h6" hidden aria-hidden="true" data-legacy-anchor="h6" />
    <div class="container-wide close-layout">
      <div class="close-copy">
        <h2 id="h6-title">{h.closing.title}</h2>
        <p class="lead close-body">{h.closing.body}</p>
        <div class="close-actions">
          <a class="btn btn--primary" href={`mailto:${t.participate.contact.email}`}>
            {t.cta.contact}<Icon name="mail" />
          </a>
          {discordInviteUrl && (
            <a
              class="btn"
              href={discordInviteUrl}
              target="_blank"
              rel="noopener noreferrer external"
              aria-label={t.participate.discord.active.ariaLabel}
            >
              {t.participate.discord.active.button}
            </a>
          )}
          <a class="text-link" href={localePath(locale, '/participate')}>
            {t.cta.howToTakePart}<Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Scroll margins for semantic + legacy anchors ---- */
  #overview, #from-organism-to-genome,
  #questions, #proposed-pilots, #discover-caligo,
  #h1, #h2, #h3, #h4, #h5, #h6 { scroll-margin-top: 5rem; }

  /* ---- H1 Cinematic hero ---- */
  .hero-cinematic {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(34rem, 56.42vw, 48rem);
    background: #0d0e10;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media-frame :global(.hero-media) {
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .hero-media-frame :global(.hero-media picture),
  .hero-media-frame :global(.hero-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .hero-overlay {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2rem,6vh,4rem) clamp(2.5rem,8vh,5rem);
  }
  .hero-overlay-inner { width: 100%; }
  .hero-copy {
    max-width: 40rem;
    margin-left: auto;
    color: #F6F7F3;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, #F6F7F3 78%, transparent);
    text-shadow: 0 1px 6px rgba(0,0,0,0.45);
  }
  .hero-title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.3vw, 3.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #F6F7F3;
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 1px 16px rgba(0,0,0,0.45);
  }
  .hero-tagline {
    margin-top: var(--space-m);
    max-width: 34ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: color-mix(in oklab, #F6F7F3 92%, transparent);
    text-shadow: 0 1px 12px rgba(0,0,0,0.5);
  }
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .hero-btn-primary {
    background: #F6F7F3;
    color: #262524;
    border-color: transparent;
  }
  .hero-btn-primary:hover { background: #FFFFFF; color: #1a1a1a; }
  .hero-btn-ghost {
    background: transparent;
    color: #F6F7F3;
    border: 1px solid color-mix(in oklab, #F6F7F3 45%, transparent);
  }
  .hero-btn-ghost:hover {
    background: color-mix(in oklab, #F6F7F3 12%, transparent);
    border-color: #F6F7F3;
    color: #F6F7F3;
  }
  .hero-attribution {
    position: absolute;
    z-index: 3;
    bottom: 0.75rem;
    right: clamp(1rem, 3vw, 1.6rem);
    margin: 0;
    max-width: 44ch;
    text-align: right;
    font-size: 0.75rem;
    line-height: 1.4;
    color: color-mix(in oklab, #F6F7F3 64%, transparent);
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    pointer-events: auto;
  }
  .hero-attribution a {
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, #F6F7F3 30%, transparent);
    text-underline-offset: 0.15em;
  }
  .hero-attribution a:hover { color: #F6F7F3; text-decoration-color: currentColor; }
  @media (min-width: 60.001rem) {
    /*
      Shift the photograph left so the butterfly's head clears the text
      column. The source is 2400x1354 (1.77) and the hero renders at almost
      exactly that aspect, so `object-fit: cover` crops vertically and
      `object-position` has no horizontal room to pan — moving the subject
      requires actually widening the rendered image and pulling it left.
      12% is enough to clear the head at every desktop width without
      cropping into the wing pattern.
    */
    .hero-media-frame :global(.hero-media img) {
      width: 112%;
      max-width: none;
      margin-left: -12%;
    }

    /* Keep the specimen and the message in separate territories. The image
       keeps its original brightness and natural composition behind the copy. */
    .hero-overlay-inner {
      width: 100%;
      margin-inline: 0;
      /*
        Capped. This used to be an uncapped `max()`, so on wide screens the
        gutter kept growing while the copy column stayed clamped — pushing
        the text LEFT, back over the butterfly. At 1975px the head cleared
        the first character by about 10px. The cap holds the text near the
        right edge where the photograph is dark and empty.
      */
      padding-right: clamp(1.25rem, calc((100vw - var(--container-wide)) / 2), 11rem);
      display: grid;
      /*
        The copy column used to be whatever `64vw` left over, which meant it
        got NARROWER as the viewport got wider — measured 454px at 1440px but
        387px at 1920px. Wider screens therefore wrapped the headline into
        more lines and made the hero taller, and Spanish (a longer headline)
        paid for it twice: 134px taller than English at 1600px.

        Now the text column is the fixed side and the photograph absorbs the
        remainder, so the headline wraps the same way at every size and the
        hero height stops depending on which language you are reading.
      */
      grid-template-columns: minmax(0, 1fr) clamp(26rem, 32vw, 34rem);
    }
    .hero-copy {
      grid-column: 2;
      max-width: none;
      margin-left: 0;
    }
  }
  @media (max-width: 60rem) {
    /* Mobile hero — translate the desktop's horizontal composition into a
       vertical one: photograph first, then a dedicated dark copy field. */
    .hero-cinematic {
      min-height: auto;
      background: #0d0e10;
    }
    .hero-media-frame {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 2400 / 1354;
    }
    .hero-overlay {
      min-height: auto;
      align-items: flex-start;
      padding-block: 0 1rem;
    }
    .hero-copy {
      max-width: 100%;
      margin-left: 0;
    }
    .hero-eyebrow {
      font-size: 0.68rem;
      line-height: 1.4;
    }
    .hero-title {
      margin-top: 0.55rem;
      max-width: 20ch;
      font-size: clamp(1.75rem, 7.2vw, 2.15rem);
      line-height: 1.06;
      text-wrap: pretty;
    }
    .hero-tagline {
      margin-top: 0.9rem;
      max-width: 38ch;
      font-size: 0.94rem;
      line-height: 1.48;
    }
    .hero-actions {
      margin-top: 1.1rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .hero-actions .btn {
      width: 100%;
      min-height: 2.8rem;
      justify-content: space-between;
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
    }
    .hero-attribution {
      position: relative;
      inset: auto;
      margin: 0;
      padding: 0 1rem 0.85rem;
      max-width: none;
      text-align: left;
      font-size: 0.58rem;
      line-height: 1.4;
      color: rgba(246,247,243,0.58);
    }
  }

  /* ---- Common section rhythm ---- */
  .section h2 { max-width: 32ch; }
  .section .lead { max-width: var(--measure); }
  .section-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---- H2 Guiding principles ---- */
  .why-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .why-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 75rem) {
    .why-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .why-item {
    padding-top: var(--space-m);
    border-top: 2px solid var(--accent);
  }
  .why-item-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    letter-spacing: -0.006em;
  }
  .why-item-body {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 28ch;
  }

  /* ---- H4 Question teasers ---- */
  .question-teasers {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .question-teaser {
    border-bottom: 1px solid var(--hairline);
  }
  .question-teaser-link {
    display: grid;
    grid-template-columns: 3rem 1fr auto auto;
    gap: var(--space-s);
    align-items: center;
    padding-block: var(--space-m);
    text-decoration: none;
    color: var(--text);
    transition: color var(--transition);
  }
  .question-teaser-link:hover,
  .question-teaser-link:focus-visible {
    color: var(--text-strong);
  }
  .question-teaser-link:hover .question-teaser-index,
  .question-teaser-link:focus-visible .question-teaser-index {
    color: var(--accent);
  }
  .question-teaser-link :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--text-faint);
    transition: transform var(--transition), color var(--transition);
  }
  .question-teaser-link:hover :global(svg),
  .question-teaser-link:focus-visible :global(svg) {
    color: var(--accent);
    transform: translateX(3px);
  }
  .question-teaser-index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    transition: color var(--transition);
  }
  .question-teaser-text {
    font-size: var(--step-0);
    font-weight: 560;
    line-height: 1.35;
    letter-spacing: -0.004em;
    color: inherit;
    max-width: 56ch;
  }
  .question-teaser-cta {
    font-size: var(--step--1);
    color: var(--accent);
    letter-spacing: 0.02em;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity var(--transition);
  }
  .question-teaser-link:hover .question-teaser-cta,
  .question-teaser-link:focus-visible .question-teaser-cta {
    opacity: 1;
  }

  /* ---- H5 Pilot cards (2×2 on desktop) ---- */
  .pilot-cards {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }
  @media (min-width: 44rem) {
    .pilot-cards { grid-template-columns: repeat(2, 1fr); }
  }
  .pilot-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(145deg, var(--bg-panel), var(--bg-inset));
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .pilot-card:focus-within {
    border-color: color-mix(in oklab, var(--accent) 48%, var(--hairline));
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .pilot-card-media { flex: none; }
  .pilot-card-media :global(.mcv-caption) {
    padding-inline: var(--space-m);
  }
  .pilot-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-m);
    flex: 1;
  }
  .pilot-card-heading {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    line-height: 1.3;
    letter-spacing: -0.006em;
  }
  /* v7.4: heading itself is the primary click target for the pilot card,
     matching the H4 question-teaser pattern (one clear affordance per hook). */
  .pilot-card-heading-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--transition), color var(--transition);
  }
  .pilot-card-heading-link:hover,
  .pilot-card-heading-link:focus-visible {
    color: var(--accent);
    background-size: 100% 1px;
    outline: none;
  }
  .pilot-card-taxon {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .pilot-card-taxon em { color: var(--highlight-strong); font-style: italic; }
  /* v7.4: single, explicit "Explore this pilot →" affordance replaces the
     verbose one-sentence hook prose that used to fill the card. The full
     published context lives on the Pilots page. */
  .pilots-cta { margin-top: var(--space-m); }

  /* ---- H6 Participate + brand close ---- */
  .section--close {
    background: var(--bg-inset);
    border-top: 1px solid var(--hairline);
  }
  .close-layout {
    display: block;
  }
  /* This block sits inside .close-layout, not directly in .container-wide,
     so the global section rhythm does not reach it. Restate it locally
     rather than leave the heading flush against its paragraph. */
  .close-copy { min-width: 0; }
  .close-copy > * + * { margin-top: var(--space-m); }
  .close-body { max-width: var(--measure); }
  .close-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
</style>
