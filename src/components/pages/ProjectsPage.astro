---
/**
 * ProjectsPage — four proposed pilots, one section each.
 *
 * This page was 2,861 words and carried twelve <details> elements (some
 * nested inside others), a sidebar table of contents for a four-item
 * list, and the same nine sources printed twice — once inline inside the
 * per-pilot disclosures and again in a footer bibliography with DOIs and
 * access dates. That is 417 words of citation apparatus on work that has
 * not started.
 *
 * What each pilot now renders: image, heading, taxon, the one-sentence
 * question, the published background, what Caligo proposes to test, who
 * would lead it, and a plain source line. Everything a reader needs to
 * decide whether to email us; nothing that performs rigour about work
 * nobody has begun.
 *
 * Removed: the motives block (an internal funding memo — "Demonstrate to
 * funders that the network can generate genomes in Latin America"), the
 * "Evidence, contributions and boundaries" disclosure whose three fields
 * were the same sentence four times with the nouns swapped, the status
 * pills repeating a phrase already in the page title, and the per-pilot
 * research-question and study-objective lists.
 *
 * renderCitations() is gone: it wrapped prose containing zero [S##]
 * tokens (all 78 live in the i18n files, none in records.ts), so it was
 * escapeHtml + set:html for nothing.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import ConceptDiagram from '../ConceptDiagram.astro';
import { getDict, type Locale } from '../../i18n';
import { PILOTS, getSource, getMediaModule } from '../../data/records';
import { PROJECTS } from '../../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const proj = t.projects as Record<string, unknown>;
const pageTitle =
  (proj.header && typeof (proj.header as Record<string, unknown>).title === 'string'
    ? (proj.header as Record<string, unknown>).title
    : proj.title) as string;
const metaTitle = proj.metaTitle as string;
const metaDescription = proj.metaDescription as string;

const p = t.pilots;
const pp = t.projects.pilotProposal;

const publishedPilots = PILOTS.filter((pilot) => pilot.publish);

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';

// Map from PILOTS.id to PROJECTS.id for the proposal lookup.
const pilotToProjectId: Record<string, string> = {
  'pilot-heliconius': 'heliconius',
  'pilot-parides':    'parides',
  'pilot-soybean':    'soybean-pests',
  'pilot-panacea':    'panacea',
};

/*
  Only the Heliconius pilot keeps a figure. The holocentric-fission
  contrast teaches something a reader cannot get from the adjacent
  paragraph; the other three restated their own captions.
*/
const pilotDiagramKind = {
  'pilot-heliconius': 'chromosome',
} as const;
const projectById = new Map(PROJECTS.map((pr) => [pr.id, pr]));
---

<Base locale={locale} title={metaTitle} description={metaDescription} page="/projects">
  <div id="overview">
    <PageHeader title={pageTitle} intro={p.opening} />
  </div>

  {/*
    container-wide supplies the gutter and the centring. This used to come
    from `section-rail-layout`, which was removed with the sidebar — and
    took the page's left and right margins with it, so the images and
    diagrams sat flush against the viewport edge.
  */}
  <div class="projects-layout container-wide section--tight">
    <ol class="pilots" aria-label={pageTitle}>
      {
        publishedPilots.map((pilot) => {
          const project = projectById.get(pilotToProjectId[pilot.id]);
          const diagramKind = pilotDiagramKind[pilot.id as keyof typeof pilotDiagramKind];
          return (
            <li id={pilot.slug} class="pilot">
            <!-- Media: 5-column slot on desktop -->
            <div class="pilot-media">
              {getMediaModule(pilot.id) && (
                <MediaCandidateViewer moduleId={pilot.id} locale={locale} aspectRatio="4 / 3" />
              )}
            </div>

            <!-- Text: 7-column slot on desktop -->
            <div class="pilot-text">
              <h2 class="pilot-heading">{pilot.heading[locale]}</h2>

              {pilot.taxon && (
                <p class="pilot-taxon">
                  <em>{pilot.taxon}</em>
                </p>
              )}

              <!-- One-sentence research question -->
              <p class="pilot-hook">{pilot.hook[locale]}</p>

              <!-- Published background -->
              <p class="pilot-body-text">{pilot.publishedContext[locale]}</p>

              {diagramKind && (
                <ConceptDiagram locale={locale} kind={diagramKind} context="pilot" />
              )}

              <!-- What Caligo proposes to test -->
              <div class="pilot-field">
                <p class="pilot-field-label">{p.fieldLabels.proposedQuestion}</p>
                <p class="pilot-field-value">{pilot.proposedQuestion[locale]}</p>
              </div>

              {project && (
                <div class="pilot-field">
                  <p class="pilot-field-label">{pp.leadsLabel}</p>
                  <p class="pilot-field-value">
                    {project.leads}
                    {project.leadsNote && (
                      <span class="pilot-leads-note">. {project.leadsNote[locale]}</span>
                    )}
                  </p>
                </div>
              )}

              {project && (
                <div class="pilot-field">
                  <p class="pilot-field-label">{pp.goalLabel}</p>
                  <p class="pilot-field-value">{project.goal[locale]}</p>
                </div>
              )}

              <!--
                Sources as a plain line of author-year links. This replaces
                a nested disclosure plus a page-footer bibliography that
                printed the same nine references a second time with DOIs
                and database access dates.
              -->
              <p class="pilot-source-line">
                <span class="pilot-source-label">{sourcesLabel}: </span>
                {pilot.sourceIds.map((sid, i) => {
                  const src = getSource(sid);
                  if (!src) return null;
                  return (
                    <>
                      {i > 0 && ' · '}
                      <a href={src.url} rel="external noopener">{src.shortLabel ?? src.citation}</a>
                    </>
                  );
                })}
              </p>
            </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>

<style>
  /* ============================================================
     Motives section
     ============================================================ */
  .section { padding-block: var(--space-xl); }
  .section--tight { padding-block: var(--space-l); }
  .section--panel {
    background: var(--bg-raised);
    border-block: 1px solid var(--hairline);
  }
  .section-intro {
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }
  .motives-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .motive-item {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--space-s);
    align-items: baseline;
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .motive-index {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .motive-text {
    color: var(--text);
    line-height: 1.55;
    max-width: var(--measure);
    font-size: var(--step--1);
  }

  /* ============================================================
     Pilot list
     ============================================================ */
  .pilots {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-bottom: var(--space-2xl);
    display: grid;
    gap: 0;
    min-width: 0;
  }

  .pilot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-top: 1px solid var(--hairline);
    scroll-margin-top: var(--scroll-margin-top);
  }
  .pilot:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  /* Desktop: 5 media / 7 text grid */
  @media (min-width: 68rem) {
    .pilot {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-xl);
      row-gap: 0;
      align-items: start;
    }
    .pilot-media :global(.mcv-stage) { max-height: 24rem; }
  }

  /* ============================================================
     Media slot
     ============================================================ */
  .pilot-media {
    min-width: 0;
  }
  .pilot-media :global(.mcv-stage) {
    max-height: min(60vh, 26rem);
  }
  .pilot-media :global(img),
  .pilot-media :global(picture) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* ============================================================
     Text slot
     ============================================================ */
  .pilot-text {
    min-width: 0;
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  /* Status pill */
  .pilot-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.18;
    color: var(--text-strong);
    max-width: 26ch;
  }

  /* Taxon */
  .pilot-taxon {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }
  .pilot-taxon em {
    color: var(--highlight-strong);
    font-style: italic;
  }

  /* One-sentence hook */
  .pilot-hook {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--text-strong);
    line-height: 1.45;
    max-width: var(--measure);
  }

  /* Summary body */
  .pilot-body-text {
    margin: 0;
    color: var(--text);
    line-height: 1.6;
    font-size: var(--step--1);
    max-width: var(--measure);
  }
  .pilot-text :global(.concept-diagram) {
    margin-block: var(--space-xs);
  }

  /* Closing thought */
  .pilot-closing {
    margin: 0;
    font-style: italic;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: var(--measure);
  }

  /* ============================================================
     Evidence, contributions and boundaries — boxed disclosure
     ============================================================ */
  .pilot-details {
    margin-top: var(--space-2xs);
  }
  .pilot-details-body {
    display: grid;
    gap: var(--space-s);
  }

  /* Field rows inside the disclosure */
  .pilot-field {
    display: grid;
    gap: 0.25rem;
  }
  .pilot-field-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    line-height: 1.5;
  }
  .pilot-field-value {
    margin: 0;
    color: var(--text);
    line-height: 1.6;
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  /* ============================================================
     Published context and sources — compact inner sub-disclosure
     ============================================================ */
  .pilot-sources-disclosure {
    margin-top: var(--space-2xs);
  }
  .pilot-sources-body {
    display: grid;
    gap: var(--space-xs);
  }
  .pilot-source-note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: var(--measure);
  }
  .pilot-sources {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .pilot-source {
    padding-block: 0.25rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .pilot-source:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .pilot-source a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 45%, transparent);
    text-underline-offset: 0.2em;
    transition: color var(--transition), text-decoration-color var(--transition);
  }
  .pilot-source a:hover,
  .pilot-source a:focus-visible {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  /* ============================================================
     Nicol block — proposed Caligo pilot disclosure
     ============================================================ */
  .pilot-proposal {
    margin-top: var(--space-2xs);
  }
  .pilot-proposal-body {
    display: grid;
    gap: var(--space-s);
  }
  .pilot-leads-note {
    color: var(--text-muted);
    font-size: var(--step--2);
  }
  .pilot-open-status {
    margin: 0;
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-inset);
    display: inline-block;
    align-self: start;
  }

  /* Extra per-pilot lists (questions, objectives) */
  .pilot-extra-list {
    list-style: none;
    padding: 0;
    margin: var(--space-2xs) 0 0;
    display: grid;
    gap: 0.25rem;
  }
  .pilot-extra-item {
    color: var(--text);
    font-size: var(--step--1);
    line-height: 1.55;
    padding-left: var(--space-m);
    position: relative;
  }
  .pilot-extra-item::before {
    content: counter(list-item) '.';
    counter-increment: list-item;
    position: absolute;
    left: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    top: 0.1em;
  }
  .pilot-extra-list {
    counter-reset: list-item;
  }
</style>
