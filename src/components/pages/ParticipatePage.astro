---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import JoinCTA from '../JoinCTA.astro';
import DiscordCTA from '../DiscordCTA.astro';
import { LINKS } from '../../data/content';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const p = t.participate;
---

<Base locale={locale} title={p.metaTitle} description={p.metaDescription} page="/participate">

  <!-- P1 — Header -->
  <PageHeader title={p.title} intro={p.intro} />

  <!-- P-Actions — Registration and community routes -->
  <section class="section">
    <div class="container-wide participation-actions">
      <JoinCTA variant="full" locale={locale} class="participation-action" />
      <DiscordCTA locale={locale} class="participation-action" />
    </div>
  </section>

  <!-- P2 — Ways to contribute (audience types) -->
  <section class="section section--panel" aria-labelledby="ways-heading">
    <div class="container-wide">
      <h2 id="ways-heading">{p.audiences.heading}</h2>
      <p class="ways-intro content-body">{p.audiences.intro}</p>
      <ul class="ways-list" role="list">
        {p.audiences.items.map((item, i) => (
          <li class="way">
            <div class="way-text">
              <h3>{item.title}</h3>
              <p class="content-body">{item.body}</p>
              {i === 1 && <a class="text-link" href="#contact">{p.audiences.proposalLink}<Icon name="arrow-right" /></a>}
            </div>
          </li>
        ))}
      </ul>
      <p class="ways-closing content-body">{p.audiences.closing}</p>
    </div>
  </section>

  <!-- P-Benefits — concrete but non-contractual participation outcomes -->
  <section class="section" aria-labelledby="benefits-heading">
    <div class="container-wide prose-column">
      <h2 id="benefits-heading">{p.benefits.heading}</h2>
      <p class="benefits-intro">{p.benefits.intro}</p>
      <ul class="benefits-list">
        {p.benefits.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- P-LangPolicy — Working languages -->
  <section class="section section--panel" aria-labelledby="lang-policy-heading">
    <div class="container-wide prose-column lang-policy-layout">
      <h2 id="lang-policy-heading" class="lang-policy-heading">{p.languagePolicy.heading}</h2>
      <p class="lang-policy-body">{p.languagePolicy.body}</p>
    </div>
  </section>

  <!--
    P-Committee — the second of the three links Nicol listed on 2026-07-14
    as ones that "deben estar ahí". The registration form and Discord were
    wired up; this sheet never was, so for three months the site asked
    people to join a network but not to help run it.
  -->
  <section class="section section--panel" aria-labelledby="committee-heading">
    <div class="container-wide prose-column">
      <h2 id="committee-heading">{t.committee.heading}</h2>
      <p class="committee-body">{t.committee.body}</p>
      <p class="committee-action">
        <a
          class="btn"
          href={LINKS.committeeForm}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.committee.cta}<Icon name="external" />
        </a>
      </p>
    </div>
  </section>

  <!-- P3 — Email CTA + safe-sharing advisory -->
  <section class="section" aria-labelledby="contact">
    <div class="container-wide contact-layout">
      <header class="contact-head">
        <span class="tick" aria-hidden="true"></span>
        <h2 id="contact">{p.contact.heading}</h2>
        <CopyEmail locale={locale} />
      </header>
      <div class="contact-body">
        <p class="contact-lede">{p.contact.body}</p>

        <!-- Safe-sharing advisory inline below the email CTA -->
        <div class="advisory">
          <header class="advisory-head">
            <span class="tick tick--ochre" aria-hidden="true"></span>
            <h3 class="advisory-title">{p.beforeSubmitting.heading}</h3>
          </header>
          <p class="advisory-body">{p.beforeSubmitting.body}</p>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---- Section rhythm ---- */

  /* ---- P2 Ways list ---- */
  .ways-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--hairline-strong);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-l);
  }
  .way {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--hairline);
    color: var(--text);
    line-height: 1.55;
  }
  .way-text { max-width: var(--measure); }
  .way-text h3 { font-size: var(--step-0); margin-bottom: var(--space-xs); }
  .way-text p { margin: 0; }
  .way-text .text-link { margin-top: var(--space-s); font-size: var(--step--1); }
  .ways-intro, .ways-closing { max-width: var(--measure); margin-top: var(--space-m); }
  @media (max-width: 48rem) {
    .ways-list { grid-template-columns: 1fr; }
  }

  /* ---- P-Benefits ---- */
  .benefits-intro {
    margin: var(--space-s) 0 var(--space-m);
    color: var(--text);
    line-height: 1.6;
  }
  .benefits-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text);
  }
  .benefits-list li {
    padding-block: var(--space-2xs);
    line-height: 1.55;
  }

  /* ---- P-Committee ---- */
  .committee-body {
    margin: var(--space-s) 0 var(--space-m);
    color: var(--text);
    line-height: 1.6;
    max-width: var(--measure);
  }
  .committee-action { margin: 0; }

  /* ---- P-LangPolicy ---- */
  .lang-policy-layout {
    display: grid;
    gap: var(--space-s);
  }
  .lang-policy-heading {
    margin: 0;
  }
  .lang-policy-body {
    margin: 0;
    color: var(--text);
    line-height: 1.6;
  }

  /* ---- P-Actions: registration and community routes ---- */
  .participation-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    align-items: stretch;
  }
  .participation-actions :global(.participation-action) {
    height: 100%;
    margin: 0;
  }
  @media (min-width: 56rem) {
    .participation-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* ---- P3 Contact layout ---- */
  .contact-layout {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .contact-layout {
      grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-xl);
    }
  }
  .contact-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .contact-head h2 {
    margin: 0;
    max-width: 20ch;
  }
  .tick {
    display: block;
    width: 2.2rem;
    height: 2px;
    background: var(--accent);
  }
  .tick--ochre { background: var(--highlight); }
  .contact-body { min-width: 0; }
  .contact-lede {
    color: var(--text);
    max-width: var(--measure);
  }

  /* Advisory callout — inline below email CTA */
  .advisory {
    margin-top: var(--space-m);
    padding: var(--space-m);
    background: var(--bg-inset);
    border: 1px solid var(--hairline);
    border-left-width: 2px;
    border-left-color: var(--highlight);
    border-radius: var(--radius);
    max-width: var(--measure);
  }
  .advisory-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: var(--space-s);
  }
  .advisory-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    letter-spacing: -0.006em;
    max-width: 24ch;
  }
  .advisory-body {
    color: var(--text);
    max-width: var(--measure);
    margin: 0;
    line-height: 1.55;
  }

</style>
