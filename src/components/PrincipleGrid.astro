---
import { PRINCIPLES, pick } from '../data/initiative';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
---

<ul class="principle-grid" role="list">
  {PRINCIPLES.map((principle, index) => (
    <li class="principle-item">
      <span class="principle-index mono" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="principle-content">
        <h3 class="principle-title">{pick(principle.title, locale)}</h3>
        <p class="principle-body">{pick(principle.body, locale)}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .principle-grid {
    list-style: none;
    /* margin-top intentionally not reset — the page owns vertical rhythm
       via `.section > .container-wide > * + *` in global.css. A blanket
       `margin: 0` here ties that rule on specificity and wins on source
       order, which is what left this block flush against its heading. */
    margin-block-end: 0;
    margin-inline: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(var(--space-l), 5vw, var(--space-2xl));
  }
  .principle-item {
    min-width: 0;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-s);
    align-content: start;
    padding-block: var(--space-m);
    border-top: 1px solid var(--hairline-strong);
  }
  .principle-item:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--hairline-strong);
  }
  .principle-index {
    padding-top: 0.12em;
    color: var(--accent-strong);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }
  .principle-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    letter-spacing: -0.006em;
    line-height: 1.25;
  }
  .principle-body {
    margin: var(--space-xs) 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.55;
  }
  @media (max-width: 44rem) {
    .principle-grid {
      grid-template-columns: 1fr;
    }
    .principle-item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
    .principle-item:last-child {
      border-bottom: 1px solid var(--hairline-strong);
    }
  }
</style>
