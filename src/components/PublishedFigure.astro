---
/**
 * PublishedFigure — a figure reproduced from a published paper.
 *
 * Deliberately not MediaCandidateViewer: this is one image with one
 * source, and the thing that matters is that the reader can tell it is
 * somebody else's published result rather than a Caligo illustration.
 * So the credit line is visible, always, directly under the image, and
 * names the paper and the licence.
 *
 * Use this only where the licence permits reuse. Check the .LICENSE.md
 * alongside the image in public/media/figures-published/ — several
 * papers this project cites are free to read but All Rights Reserved,
 * which is not the same thing.
 */
import type { Locale } from '../i18n';

interface Props {
  readonly src: string;
  readonly alt: string;
  readonly caption: string;
  readonly citation: string;
  readonly citationUrl: string;
  readonly licence: string;
  readonly licenceUrl: string;
  /**
   * What we changed, if anything. CC BY and CC BY-SA both require that
   * adaptations are indicated — cropping one panel out of a multi-panel
   * figure is an adaptation. CC0 does not require it, so this is optional.
   */
  readonly changes?: string;
  readonly width: number;
  readonly height: number;
  readonly locale: Locale;
}

const {
  src, alt, caption, citation, citationUrl, licence, licenceUrl, changes, width, height, locale,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fromLabel = locale === 'es' ? 'Figura de' : 'Figure from';
---

<figure class="published-figure">
  <img
    src={`${base}${src}`}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <p class="pf-caption">{caption}</p>
    <p class="pf-credit mono">
      <span class="pf-from">{fromLabel}</span>{' '}
      <a href={citationUrl} rel="external noopener">{citation}</a>
      {' · '}
      <a href={licenceUrl} rel="license external noopener">{licence}</a>
      {changes && <span class="pf-changes">{' · '}{changes}</span>}
    </p>
  </figcaption>
</figure>

<style>
  .published-figure {
    margin: 0;
    padding: var(--space-m);
    background: var(--bg-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .published-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 2px);
    /* Published figures are drawn on white. On a dark background an
       untreated white plate glares; a slight inset border reads as a
       printed plate instead. */
    background: #fff;
    border: 1px solid var(--hairline);
  }
  figcaption {
    margin-top: var(--space-s);
  }
  .pf-caption {
    margin: 0;
    color: var(--text);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .pf-credit {
    margin: 0.5rem 0 0;
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--text-faint);
  }
  .pf-from {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pf-credit a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--hairline-strong);
  }
  .pf-credit a:hover { color: var(--text-strong); text-decoration-color: currentColor; }
  .pf-changes { color: var(--text-faint); }
</style>
