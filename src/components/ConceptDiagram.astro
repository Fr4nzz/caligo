            <path d="M-1 3 C -15 -7 -23 1 -19 9 C -15 15 -5 13 -1 8 Z" class="vch-wing" />
            <path d="M1 3 C 15 -7 23 1 19 9 C 15 15 5 13 1 8 Z" class="vch-wing" />
          </g>
          <text x="0" y="-8" class="vch-idtag">{c.voucher.camid}</text>
        </g>

        {/* Body stored in a tube carrying its own tube ID (barcode). */}
        <g class="vch-tube-group" transform="translate(290 126)">
          <g class="vch-cap-group">
            <rect x="-12" y="-30" width="24" height="13" rx="4" class="vch-cap" />
            <rect x="-13" y="-19" width="26" height="5" rx="2" class="vch-cap" />
          </g>
          <rect x="-12" y="-14" width="24" height="48" rx="9" class="vch-tube" />
          <rect x="-12" y="-6" width="24" height="16" class="vch-label" />
          <path d="M-8 -3v10 M-5 -3v10 M-2 -3v10 M1 -3v10 M5 -3v10 M8 -3v10" class="vch-barcode" />
          <rect x="-3" y="16" width="6" height="14" rx="3" class="vch-body-inside" />
        </g>

        {/* Record: CAMID, tube ID and collector lead an intentionally abbreviated row. */}
        <g class="vch-sheet-group" transform="translate(498 90)">
          <rect x="-76" y="-33" width="152" height="66" rx="6" class="vch-sheet" />
          <rect x="-76" y="-33" width="152" height="15" class="vch-sheet-head" />
          <rect x="-76" y="-3" width="152" height="18" class="vch-row-hit" />
          <path d="M-38 -33V33 M0 -33V33 M38 -33V33 M-76 -18H76 M-76 -3H76 M-76 15H76" class="vch-grid" />
          <text x="-57" y="-22" class="vch-field-head">{c.voucher.camid}</text>
          <text x="-19" y="-22" class="vch-field-head">{c.voucher.tubeid}</text>
          <text x="19" y="-22" class="vch-field-head">{c.voucher.collector}</text>
          <text x="57" y="-22" class="vch-field-head vch-record-more">…</text>
          <g class="vch-record-values">
            <text x="-57" y="9" class="vch-record-value">{c.voucher.camid}</text>
            <text x="-19" y="9" class="vch-record-value">{c.voucher.tubeid}</text>
            <text x="19" y="9" class="vch-record-value vch-record-collector">{c.voucher.collector}</text>
            <text x="57" y="9" class="vch-record-value vch-record-more">…</text>
          </g>
          <path d="M-70 -11h18 M-32 -11h18 M6 -11h18 M45 -11h18" class="vch-cell" />
          <path d="M-70 25h18 M-32 25h18 M6 25h18 M45 25h18" class="vch-cell" />
        </g>

        <text x="86" y="152" class="node-label vch-specimen-label">{c.voucher.specimen}</text>
        <text x="290" y="20" class="group-label">{c.voucher.envelope}</text>
        <text x="290" y="174" class="node-label">{c.voucher.tube}</text>
        <text x="498" y="152" class="node-label">{c.voucher.record}</text>
        <text x="300" y="188" class="footer-label">{c.voucher.link}</text>
      </g>
    )}
  </svg>

  {kind === 'connectivity' ? (
    <ul class="concept-mobile-flow connectivity-mobile-outcomes" aria-label={k.title}>
      {connectivityOutcomes.map((outcome) => (
        <li data-mobile-step>
          <span class="connectivity-outcome-cue">{outcome.cue}</span>
          <strong>{outcome.title}</strong>
          <span>{outcome.detail}</span>
        </li>
      ))}
    </ul>
  ) : (
    <ol class="concept-mobile-flow" aria-label={k.title}>
      {mobileSteps.map((step, index) => (
        <li data-mobile-step>
          <span class="mobile-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
  )}
  {kind === 'connectivity' && (
    <p class="concept-evidence">
      <span>{c.connectivity.evidenceLead}</span>
      <a href="https://doi.org/10.1038/s41586-024-07263-w" target="_blank" rel="noopener noreferrer external">
        {c.connectivity.rosserPrefix} <i lang="la">{c.connectivity.rosserTaxon}</i>{c.connectivity.rosserTail}
      </a>
      <span>{c.connectivity.evidenceJoin}</span>
      <a href="https://doi.org/10.1073/pnas.2410939122" target="_blank" rel="noopener noreferrer external">
        {c.connectivity.ithomiiniPrefix}<i lang="la">{c.connectivity.ithomiiniTaxonOne}</i>{c.connectivity.ithomiiniAnd}<i lang="la">{c.connectivity.ithomiiniTaxonTwo}</i>{c.connectivity.evidenceTail}
      </a>
    </p>
  )}
</figure>

<style>
  .concept-diagram {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }
  .concept-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-s);
    padding: var(--space-s) var(--space-m);
    color: var(--text-strong);
    font-size: var(--step--1);
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--bg-panel) 76%, transparent);
  }
  .concept-title-group {
    display: grid;
    gap: 0.18rem;
    min-width: min(100%, 15rem);
  }
  .concept-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .concept-heading strong {
    display: block;
    font-weight: 620;
    font-size: var(--step-0);
    line-height: 1.25;
  }
  .concept-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.45rem;
    padding: 0.52rem 0.82rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 12%, var(--bg-panel));
    color: var(--accent-strong);
    font: 650 var(--step--1)/1.1 var(--font-body);
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .concept-play:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
  }
  .concept-play:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .play-icon {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg-panel);
    font-size: 0.55rem;
    line-height: 1;
    text-indent: 0.08rem;
  }
  .concept-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 12.5rem;
    color: var(--text-muted);
    padding-inline: var(--space-xs);
  }
  .group-label,
  .footer-label,
  .node-label,
  .micro-label {
    font-family: var(--font-mono);
    fill: var(--text-muted);
    text-anchor: middle;
  }
  .group-label { font-size: 12px; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; fill: var(--accent-strong); }
  .node-label { font-size: 10.5px; }
  .micro-label { font-size: 9px; fill: var(--text-faint); }
  .footer-label { font-size: 11px; fill: var(--text-faint); }
  .flow,
  .relation,
  .icon-line {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .relation { stroke-dasharray: 5 5; stroke: var(--accent); }
  .arrowhead { fill: var(--accent); }
  .introgression-arrowhead { fill: var(--signal); }
  .chromosome-segment { opacity: 0.94; }
  .chromosome-segment--orange { fill: var(--accent); }
  .chromosome-segment--yellow { fill: var(--highlight); }
  .chromosome-outline {
    fill: none;
    stroke: color-mix(in oklab, var(--text-strong) 54%, transparent);
    stroke-width: 1.2;
  }
  .breakpoint-line {
    fill: none;
    stroke: var(--bg-panel);
    stroke-width: 3;
    stroke-dasharray: 3 2;
  }
