---
import { getDict, type Locale } from '../i18n';

type DiagramKind = 'chromosome' | 'wfusion' | 'connectivity' | 'monitoring' | 'migration' | 'voucher';

interface Props {
  readonly locale: Locale;
  readonly kind: DiagramKind;
  readonly context?: 'science' | 'pilot';
}

const { locale, kind, context = 'science' } = Astro.props;
const id = `concept-${context}-${kind}`;
const t = getDict(locale);

const copy = {
  en: {
    conceptual: 'Concept diagram',
    play: 'Play the explanation',
    replay: 'Replay',
    chromosome: {
      title: 'What happens when a chromosome breaks',
      desc: 'In most animals the spindle grips a chromosome at a single anchor point. If the chromosome breaks, the piece that does not carry that point is not pulled into the daughter cells and is lost. Butterflies and moths have holocentric chromosomes: the spindle anchors along the whole length, so both pieces of a break keep an anchor and both are inherited. That is why chromosome number can change in this group. The dots mark spindle anchors and their number is schematic.',
      mostAnimals: 'Most animals',
      lepidoptera: 'Butterflies and moths',
      onePointA: 'one anchor',
      onePointB: 'at a single point',
      allAlongA: 'anchors along',
      allAlongB: 'the whole chromosome',
      lostPiece: 'the piece without an anchor is lost',
      bothKept: 'both pieces are kept',
      footnote: 'The orange dots are the spindle anchor. This is why the number of chromosomes can change.',
      question: 'compare chromosome-scale assemblies',
    },
    wfusion: {
      title: 'A fusion with the W chromosome',
      desc: 'In butterflies and moths the female carries a chromosome the male never has: the W. A fusion can attach an ordinary chromosome, an autosome, to that W. From then on that copy is no longer inherited like the others; it passes only from mother to daughter. Three such fusions have been identified in Heliconius, each one independently.',
      femaleHeading: 'Here the female carries a chromosome the male never has',
      male: 'male',
      female: 'female',
      wNote: 'the W travels only in females',
      fusionHeading: 'A fusion can attach an ordinary chromosome',
      autosome: 'autosome',
      outcome: 'That copy is then passed only from mother to daughter.',
      footnote: 'Three independent fusions of this kind are known in Heliconius (Rueda-M et al. 2024).',
      question: 'compare chromosome-scale assemblies',
    },
    connectivity: {
      title: 'Population connectivity and gene flow',
      desc: 'The first panel shows early, sustained gene flow homogenising two incipient lineages until they no longer remain distinct. The second shows introgression between more divergent lineages, followed by the persistence of a hybrid lineage. This rare outcome does not imply equal genomic contributions or blended traits. Colours and branch lengths guide the explanation and do not represent measured values.',
      earlyTitle: 'early, sustained gene flow',
      incipientLineages: 'incipient lineages',
      earlyFlow: 'gene flow homogenises differences',
      collapseOutcome: 'Sustained gene flow prevents lasting divergence',
      lateTitle: 'introgression after divergence',
      divergentLineages: 'more divergent lineages',
      recipientLineage: 'recipient lineage',
      donorLineage: 'donor lineage',
      oneLineage: 'one lineage remains',
      newHybridSpecies: 'new hybrid species',
      rareOutcomeLabel: 'rare outcome',
      introgression: 'trait-linked regions cross lineages',
      rareOutcomeLead: 'An independently evolving',
      rareOutcomeTail: 'hybrid lineage persists',
      evidenceLead: 'Published evidence: ',
      rosserPrefix: 'hybrid speciation in',
      rosserTaxon: 'Heliconius elevatus',
      rosserTail: ' (Heliconiini)',
      evidenceJoin: '. ',
      ithomiiniPrefix: 'Putative hybrid origins in Ithomiini (',
      ithomiiniTaxonOne: 'Melinaea',
      ithomiiniAnd: ' and ',
      ithomiiniTaxonTwo: 'Mechanitis',
      evidenceTail: ').',
    },
    monitoring: {
      title: 'Movement and resistance monitoring',
      desc: 'Repeated field sampling and confirmed species identification support tests of movement and candidate resistance-associated variants. Validation then determines whether those signals can support monitoring.',
      sample: 'repeat sampling',
      identify: 'confirm species',
      movement: 'test movement',
      candidates: 'candidate variants',
      validate: 'validate monitoring',
    },
    migration: {
      title: 'Testing seasonal origins and routes',
      desc: 'Samples from different places and seasons can test possible origins and connections. Movement observations and environmental evidence help evaluate the resulting hypotheses.',
      sampling: 'places + seasons',
      origins: 'possible origins?',
      routes: 'connections?',
      evidence: 'independent evidence',
    },
    voucher: {
      title: 'Voucher: specimen, sample, record',
      desc: t.home.journey.voucherDiagram.description,
      specimen: 'specimen',
      envelope: 'wings → envelope',
      tube: 'body → tube',
      record: 'record row',
      collector: t.home.journey.voucherDiagram.collector,
      camid: 'CAMID',
      tubeid: 'TUBE ID',
      link: 'one record links identifiers and provenance',
    },
  },
  es: {
    conceptual: 'Esquema conceptual',
    play: 'Reproducir la explicación',
    replay: 'Repetir',
    chromosome: {
      title: 'Qué pasa cuando un cromosoma se parte',
      desc: 'En la mayoría de los animales el huso sujeta el cromosoma en un solo punto de anclaje. Si el cromosoma se parte, el trozo que no lleva ese punto no se reparte hacia las células hijas y se pierde. Las mariposas y polillas tienen cromosomas holocéntricos: el huso se ancla a lo largo de todo el cromosoma, así que los dos trozos de una ruptura conservan anclaje y los dos se heredan. Por eso el número de cromosomas puede cambiar en este grupo. Los puntos marcan anclajes al huso y su cantidad es esquemática.',
      mostAnimals: 'La mayoría de los animales',
      lepidoptera: 'Mariposas y polillas',
      onePointA: 'un anclaje',
      onePointB: 'en un punto',
      allAlongA: 'anclaje por',
      allAlongB: 'todo el cromosoma',
      lostPiece: 'se pierde el trozo sin anclaje',
      bothKept: 'se conservan los dos',
      footnote: 'Los puntos naranjas son el anclaje al huso. Por eso el número de cromosomas puede cambiar.',
      question: 'comparar ensamblajes a escala cromosómica',
    },
    wfusion: {
      title: 'Una fusión con el cromosoma W',
      desc: 'En mariposas y polillas la hembra lleva un cromosoma que el macho nunca tiene: el W. Una fusión puede unirle un cromosoma corriente, un autosoma. Desde ese momento esa copia deja de heredarse como las demás y pasa solo de madre a hija. En Heliconius se han identificado tres fusiones de este tipo, cada una de forma independiente.',
      femaleHeading: 'Aquí la hembra lleva un cromosoma que el macho nunca tiene',
      male: 'macho',
      female: 'hembra',
      wNote: 'el W solo va en las hembras',
      fusionHeading: 'Una fusión puede pegarle un cromosoma corriente',
      autosome: 'autosoma',
      outcome: 'Esa copia ya solo pasa de madre a hija.',
      footnote: 'En Heliconius se conocen tres fusiones así, independientes (Rueda-M et al. 2024).',
      question: 'comparar ensamblajes a escala cromosómica',
    },
    connectivity: {
      title: 'Conectividad poblacional y flujo génico',
      desc: 'El primer panel muestra cómo el flujo génico temprano y sostenido homogeneiza dos linajes incipientes hasta que dejan de permanecer separados. El segundo muestra introgresión entre linajes más divergentes, seguida por la persistencia de un linaje híbrido. Este desenlace raro no implica aportes genómicos iguales ni rasgos mezclados. Los colores y la longitud de las ramas guían la explicación y no representan valores medidos.',
      earlyTitle: 'flujo génico temprano y sostenido',
      incipientLineages: 'linajes incipientes',
      earlyFlow: 'el flujo génico homogeneiza las diferencias',
      collapseOutcome: 'El flujo génico sostenido impide una divergencia duradera',
      lateTitle: 'introgresión después de la divergencia',
      divergentLineages: 'linajes más divergentes',
      recipientLineage: 'linaje receptor',
      donorLineage: 'linaje donante',
      oneLineage: 'permanece un linaje',
      newHybridSpecies: 'nueva especie híbrida',
      rareOutcomeLabel: 'desenlace raro',
      introgression: 'regiones ligadas a rasgos cruzan entre linajes',
      rareOutcomeLead: 'Persiste un linaje híbrido',
      rareOutcomeTail: 'que evoluciona de forma independiente',
      evidenceLead: 'Evidencia publicada: ',
      rosserPrefix: 'especiación híbrida en',
      rosserTaxon: 'Heliconius elevatus',
      rosserTail: ' (Heliconiini)',
      evidenceJoin: '. ',
      ithomiiniPrefix: 'Orígenes híbridos putativos en Ithomiini (',
      ithomiiniTaxonOne: 'Melinaea',
      ithomiiniAnd: ' y ',
      ithomiiniTaxonTwo: 'Mechanitis',
      evidenceTail: ').',
    },
    monitoring: {
      title: 'Monitoreo de movimiento y resistencia',
      desc: 'El muestreo de campo repetido y la identificación confirmada de especies sustentan pruebas de movimiento y de variantes candidatas asociadas con resistencia. La validación determina después si esas señales pueden servir para el monitoreo.',
      sample: 'repetir muestreo',
      identify: 'confirmar especie',
      movement: 'estudiar movimiento',
      candidates: 'variantes candidatas',
      validate: 'validar monitoreo',
    },
    migration: {
      title: 'Estudiar orígenes y rutas estacionales',
      desc: 'Las muestras de distintos lugares y temporadas permiten estudiar posibles orígenes y conexiones. Las observaciones de movimiento y la evidencia ambiental ayudan a evaluar las hipótesis resultantes.',
      sampling: 'lugares + temporadas',
      origins: '¿orígenes posibles?',
      routes: '¿conexiones?',
      evidence: 'evidencia independiente',
    },
    voucher: {
      title: 'Voucher: ejemplar, muestra, registro',
      desc: t.home.journey.voucherDiagram.description,
      specimen: 'ejemplar',
      envelope: 'alas → sobre',
      tube: 'cuerpo → tubo',
      record: 'fila de registro',
      collector: t.home.journey.voucherDiagram.collector,
      camid: 'CAMID',
      tubeid: 'ID DE TUBO',
      link: 'un registro conecta identificadores y procedencia',
    },
  },
} as const;

const c = copy[locale];
const k = c[kind];
const connectivityOutcomes = kind === 'connectivity'
  ? [
      {
        cue: c.connectivity.earlyTitle,
        title: c.connectivity.oneLineage,
        detail: c.connectivity.earlyFlow,
      },
      {
        cue: c.connectivity.rareOutcomeLabel,
        title: c.connectivity.newHybridSpecies,
        detail: `${c.connectivity.lateTitle}. ${c.connectivity.introgression}`,
      },
    ]
  : [];
const mobileSteps: readonly string[] = kind === 'chromosome'
  ? [
      `${c.chromosome.mostAnimals}: ${c.chromosome.onePointA} ${c.chromosome.onePointB}`,
      c.chromosome.lostPiece,
      `${c.chromosome.lepidoptera}: ${c.chromosome.allAlongA} ${c.chromosome.allAlongB}`,
      c.chromosome.bothKept,
    ]
  : kind === 'wfusion'
    ? [
        `${c.wfusion.male}: Z Z`,
        `${c.wfusion.female}: Z W`,
        c.wfusion.fusionHeading,
        c.wfusion.outcome,
      ]
  : kind === 'connectivity'
    ? []
    : kind === 'monitoring'
      ? [c.monitoring.sample, c.monitoring.identify, c.monitoring.movement, c.monitoring.candidates, c.monitoring.validate]
      : kind === 'migration'
        ? [c.migration.sampling, c.migration.origins, c.migration.routes, c.migration.evidence]
        : [
            `${c.voucher.collector} → ${c.voucher.specimen}`,
            `${c.voucher.envelope} (${c.voucher.camid})`,
            `${c.voucher.tube} (${c.voucher.tubeid})`,
            `${c.voucher.record}: ${c.voucher.camid} + ${c.voucher.tubeid} + ${c.voucher.collector} + …`,
          ];
---

<figure
  id={id}
  class="concept-diagram"
  data-kind={kind}
  data-context={context}
  data-concept-diagram
  data-label-replay={c.replay}
  data-duration-ms={kind === 'connectivity' ? '6500' : '5000'}
  aria-busy="false"
>
  <figcaption class="concept-heading">
    <span class="concept-title-group">
      <span class="concept-kicker">{c.conceptual}</span>
      <strong>{k.title}</strong>
    </span>
    <button type="button" class="concept-play" data-concept-play>
      <span class="play-icon" aria-hidden="true">▶</span>
      <span data-concept-play-label>{c.play}</span>
    </button>
  </figcaption>

  <svg class="concept-svg" viewBox={kind === 'connectivity' ? '0 0 720 255' : kind === 'chromosome' ? '0 0 600 266' : kind === 'wfusion' ? '0 0 600 266' : '0 0 600 190'} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{k.title}</title>
    <desc id={`${id}-desc`}>{k.desc}</desc>
    <defs>
      <marker id={`${id}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" class="arrowhead" />
      </marker>
      <marker id={`${id}-phylo-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" class="introgression-arrowhead" />
      </marker>
      <g id={`${id}-butterfly`}>
        <path d="M-2 -1 C-6 -12 -18 -12 -17 -2 C-16 5 -9 8 -2 4 Z" class="butterfly-wing" />
        <path d="M2 -1 C6 -12 18 -12 17 -2 C16 5 9 8 2 4 Z" class="butterfly-wing" />
        <path d="M-2 3 C-8 3 -13 8 -9 11 C-5 13 -2 8 0 5 Z" class="butterfly-wing butterfly-wing--hind" />
        <path d="M2 3 C8 3 13 8 9 11 C5 13 2 8 0 5 Z" class="butterfly-wing butterfly-wing--hind" />
        <path d="M0 -6 V8 M0 -5 C-2 -9 -5 -10 -7 -10 M0 -5 C2 -9 5 -10 7 -10" class="butterfly-body" />
      </g>
    </defs>

    {kind === 'chromosome' && (
      <g class="diagram-scene chromosome-scene">
        {/* Most animals: a single anchor point, so a break loses one piece. */}
        <text x="0" y="18" class="chr-head">{c.chromosome.mostAnimals}</text>
        <text x="0" y="60" class="chr-tag">{c.chromosome.onePointA}</text>
        <text x="0" y="76" class="chr-tag">{c.chromosome.onePointB}</text>

        <path d="M176 42 H263 V68 H176 A13 13 0 0 1 163 55 A13 13 0 0 1 176 42 Z" class="chr-body" />
        <circle cx="213" cy="55" r="7" class="chr-anch" />
        <g class="chr-lost">
          <path d="M263 42 H350 A13 13 0 0 1 363 55 A13 13 0 0 1 350 68 H263 Z" class="chr-body chr-lost-body" />
        </g>
        <rect x="259" y="43" width="8" height="24" class="chr-seam chr-seam--a" />
        <path d="M263 36 V74" class="chr-cut" />
        <text x="345" y="100" class="chr-grey chr-say" text-anchor="middle">{c.chromosome.lostPiece}</text>

        <path d="M0 128 H600" class="chr-rule" />

        {/* Butterflies and moths: anchors along the whole chromosome, so both
            pieces of the same break keep an anchor and both are inherited. */}
        <text x="0" y="158" class="chr-head">{c.chromosome.lepidoptera}</text>
        <text x="0" y="200" class="chr-tag">{c.chromosome.allAlongA}</text>
        <text x="0" y="216" class="chr-tag">{c.chromosome.allAlongB}</text>

        <g class="chr-fis-l">
          <path d="M176 182 H263 V208 H176 A13 13 0 0 1 163 195 A13 13 0 0 1 176 182 Z" class="chr-body" />
          <g class="chr-anch">
            <circle cx="177" cy="195" r="5" /><circle cx="197" cy="195" r="5" />
            <circle cx="217" cy="195" r="5" /><circle cx="237" cy="195" r="5" />
            <circle cx="257" cy="195" r="5" />
          </g>
        </g>
        <g class="chr-fis-r">
          <path d="M263 182 H350 A13 13 0 0 1 363 195 A13 13 0 0 1 350 208 H263 Z" class="chr-body" />
          <g class="chr-anch">
            <circle cx="269" cy="195" r="5" /><circle cx="289" cy="195" r="5" />
            <circle cx="309" cy="195" r="5" /><circle cx="329" cy="195" r="5" />
            <circle cx="349" cy="195" r="5" />
          </g>
        </g>
        <rect x="259" y="183" width="8" height="24" class="chr-seam chr-seam--b" />
        <path d="M263 176 V214" class="chr-cut" />
        <text x="390" y="200" class="chr-out chr-say">{c.chromosome.bothKept}</text>

        <text x="0" y="252" class="chr-note">{c.chromosome.footnote}</text>
      </g>
    )}

    {kind === 'wfusion' && (
      <g class="diagram-scene wfusion-scene">
        {/* In Lepidoptera the female is the heterogametic sex: ZW, not XY. */}
        <text x="0" y="18" class="chr-head">{c.wfusion.femaleHeading}</text>

        <text x="0" y="62" class="wf-who">{c.wfusion.male}</text>
        <rect x="150" y="48" width="58" height="20" rx="10" class="wf-chr" />
        <text x="179" y="63" class="wf-glyph">Z</text>
        <rect x="216" y="48" width="58" height="20" rx="10" class="wf-chr" />
        <text x="245" y="63" class="wf-glyph">Z</text>

        <text x="0" y="98" class="wf-who">{c.wfusion.female}</text>
        <rect x="150" y="84" width="58" height="20" rx="10" class="wf-chr" />
        <text x="179" y="99" class="wf-glyph">Z</text>
        <rect x="216" y="84" width="40" height="20" rx="10" class="wf-w" />
        <text x="236" y="99" class="wf-glyph wf-glyph--on-accent">W</text>
        <text x="272" y="99" class="chr-tag">{c.wfusion.wNote}</text>

        <path d="M0 126 H600" class="chr-rule" />

        {/* The fusion itself: the W and an autosome close together and become
            one chromosome that is transmitted only down the female line. */}
        <text x="0" y="156" class="chr-head">{c.wfusion.fusionHeading}</text>

        <g class="wf-in wf-in-w">
          <rect x="150" y="182" width="40" height="22" rx="11" class="wf-w" />
          <text x="170" y="198" class="wf-glyph wf-glyph--on-accent">W</text>
        </g>
        <g class="wf-in wf-in-a">
          <rect x="216" y="182" width="104" height="22" rx="11" class="wf-chr" />
          <text x="268" y="198" class="wf-glyph">{c.wfusion.autosome}</text>
        </g>
        <g class="wf-neo">
          <rect x="176" y="182" width="40" height="22" rx="11" class="wf-w" />
          <rect x="206" y="182" width="104" height="22" rx="11" class="wf-chr" />
          <rect x="176" y="182" width="34" height="22" class="wf-w wf-w--butt" />
          <text x="192" y="198" class="wf-glyph wf-glyph--on-accent">W</text>
          <text x="262" y="198" class="wf-glyph">{c.wfusion.autosome}</text>
        </g>

        <text x="0" y="232" class="chr-out wf-say">{c.wfusion.outcome}</text>
        <text x="0" y="252" class="chr-note">{c.wfusion.footnote}</text>
      </g>
    )}

    {kind === 'connectivity' && (
      <g class="diagram-scene connectivity-scene">
        <path d="M360 18 V238" class="gene-flow-divider" />

        {/* Outcome 1: sustained exchange homogenises incipient lineages before they remain distinct. */}
        <g class="gene-flow-panel gene-flow-panel--homogenisation">
          <text x="180" y="18" class="group-label gene-flow-panel-title">{c.connectivity.earlyTitle}</text>
          <path d="M180 198 V168" class="lineage-path lineage-trunk early-lineage-trunk" />
          <path d="M180 168 C158 151 143 131 126 113" class="lineage-path early-split-branch early-split-branch--dark" />
          <path d="M180 168 C202 151 217 131 234 113" class="lineage-path early-split-branch early-split-branch--pale" />
          <path d="M126 113 C136 90 155 70 180 57" class="lineage-path early-merge-branch early-merge-branch--dark" />
          <path d="M234 113 C224 90 205 70 180 57" class="lineage-path early-merge-branch early-merge-branch--pale" />
          <path d="M180 57 V38" class="lineage-path homogenised-lineage" />
          <circle cx="180" cy="168" r="4.5" class="lineage-node early-divergence-node" />
          <circle cx="126" cy="113" r="3.5" class="lineage-node early-midpoint-node early-midpoint-node--dark" />
          <circle cx="234" cy="113" r="3.5" class="lineage-node early-midpoint-node early-midpoint-node--pale" />
          <circle cx="180" cy="57" r="4.5" class="lineage-node homogenisation-node" />

          <g class="lineage-butterfly lineage-butterfly--ancestor early-ancestor" transform="translate(180 204) scale(.7)">
            <use href={`#${id}-butterfly`} />
          </g>
          <g class="early-lineage-glyphs">
            <g class="lineage-butterfly lineage-butterfly--dark" transform="translate(126 113) scale(.68)">
              <use href={`#${id}-butterfly`} />
            </g>
            <g class="lineage-butterfly lineage-butterfly--pale" transform="translate(234 113) scale(.68)">
              <use href={`#${id}-butterfly`} />
            </g>
          </g>
          <g class="lineage-butterfly lineage-butterfly--ancestor homogenised-butterfly" transform="translate(180 39) scale(.86)">
            <use href={`#${id}-butterfly`} />
          </g>

          <path d="M143 133 H217" class="gene-flow-link early-gene-flow" marker-start={`url(#${id}-phylo-arrow)`} marker-end={`url(#${id}-phylo-arrow)`} />
          <text x="180" y="92" class="micro-label incipient-label">{c.connectivity.incipientLineages}</text>
          <text x="180" y="73" class="micro-label final-state-label one-lineage-label">{c.connectivity.oneLineage}</text>
          <text x="180" y="224" class="footer-label panel-outcome panel-outcome--collapse">{c.connectivity.collapseOutcome}</text>
        </g>

        {/* Outcome 2: a discrete allele enters a recipient-derived branch; the new lineage is not a 50/50 blend. */}
        <g class="gene-flow-panel gene-flow-panel--hybrid-speciation">
          <text x="540" y="18" class="group-label gene-flow-panel-title">{c.connectivity.lateTitle}</text>
          <path d="M540 198 V169" class="lineage-path lineage-trunk late-lineage-trunk" />
          <path d="M540 169 C520 149 500 129 481 111" class="lineage-path late-split-branch late-split-branch--recipient" />
          <path d="M540 169 C564 148 588 127 613 111" class="lineage-path late-split-branch late-split-branch--donor" />
          <path d="M481 111 C464 93 449 72 435 53" class="lineage-path late-tip-branch late-tip-branch--recipient" />
          <path d="M613 111 C628 92 641 72 653 53" class="lineage-path late-tip-branch late-tip-branch--donor" />
          <path d="M481 111 C500 94 522 72 548 50" class="lineage-path hybrid-lineage-branch" />
          <circle cx="540" cy="169" r="4.5" class="lineage-node late-divergence-node" />
          <circle cx="481" cy="111" r="4.5" class="lineage-node hybrid-origin-node" />
          <circle cx="613" cy="111" r="3.5" class="lineage-node donor-midpoint-node" />

          <g class="lineage-butterfly lineage-butterfly--ancestor late-ancestor" transform="translate(540 204) scale(.7)">
            <use href={`#${id}-butterfly`} />
          </g>
          <g class="lineage-butterfly lineage-butterfly--dark recipient-butterfly" transform="translate(432 48) scale(.86)">
            <use href={`#${id}-butterfly`} />
          </g>
          <g class="lineage-butterfly lineage-butterfly--pale donor-butterfly" transform="translate(660 48) scale(.86)">
            <use href={`#${id}-butterfly`} />
            <path d="M3 -1 L7 -5 L11 -1 L7 3 Z" class="trait-mark trait-mark--source" />
          </g>
          <g class="lineage-butterfly lineage-butterfly--dark hybrid-butterfly" transform="translate(548 43) scale(.92)">
            <use href={`#${id}-butterfly`} />
