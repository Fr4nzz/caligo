---
import type { Locale } from '../i18n';

type DiagramKind = 'chromosome' | 'introgression';

interface Props {
  readonly locale: Locale;
  readonly kind: DiagramKind;
  readonly context?: 'science' | 'pilot';
}

const { locale, kind, context = 'science' } = Astro.props;
const id = `concept-${context}-${kind}`;

const copy = {
  en: {
    conceptual: 'Concept diagram',
    play: 'Play the explanation',
    replay: 'Replay',
    chromosome: {
      title: 'What happens when a chromosome breaks',
      desc: 'In most animals the spindle grips a chromosome at a single anchor point. If the chromosome breaks, the piece that does not carry that point is not pulled into the daughter cells and is lost. Butterflies and moths have holocentric chromosomes: the spindle anchors along the whole length, so both pieces of a break keep an anchor and both are inherited. That is why chromosome number can change in this group. The dots mark spindle anchors and their number is schematic.',
      mostAnimals: 'Most animals',
      lepidoptera: 'Butterflies and moths',
      onePointA: 'one anchor',
      onePointB: 'at a single point',
      allAlongA: 'anchors along',
      allAlongB: 'the whole chromosome',
      lostPiece: 'the piece without an anchor is lost',
      bothKept: 'both pieces are kept',
      footnote: 'The orange dots are the spindle anchor. This is why the number of chromosomes can change.',
      question: 'compare chromosome-scale assemblies',
    },
    introgression: {
      title: 'One genome, two ancestors',
      desc: 'The 21 chromosomes of a single Heliconius elevatus butterfly, drawn as grey bars. Grey is the 99% of the genome inherited from one parent species, Heliconius pardalinus. The coloured blocks are the remaining 1%, inherited from a second species, Heliconius melpomene, through hybridisation, and each colour marks what that piece of DNA controls. Vermillion marks colour pattern, on chromosomes 1, 5, 10, 12, 13, 15 and 18. Blue marks wing shape, on chromosome 20. Green marks host plant, on chromosome 2. Purple marks pheromones, on chromosomes 19 and 20. The blocks are spread across many chromosomes rather than clumped on one. Chromosome lengths and the position of each block within a chromosome are schematic.',
      hook: 'The 21 chromosomes of one Heliconius elevatus butterfly',
      legendGrey: 'Grey: the 99% inherited from H. pardalinus.',
      legendColour: 'Coloured: the 1% inherited from H. melpomene, labelled by trait:',
      traitColour: 'colour pattern',
      traitWing: 'wing shape',
      traitPlant: 'host plant',
      traitScent: 'pheromones',
      outcome: 'The 1% is scattered across the genome and helps make H. elevatus distinct.',
      question: 'compare chromosome-scale assemblies',
    },
  },
  es: {
    conceptual: 'Esquema conceptual',
    play: 'Reproducir la explicación',
    replay: 'Repetir',
    chromosome: {
      title: 'Qué pasa cuando un cromosoma se parte',
      desc: 'En la mayoría de los animales el huso sujeta el cromosoma en un solo punto de anclaje. Si el cromosoma se parte, el trozo que no lleva ese punto no se reparte hacia las células hijas y se pierde. Las mariposas y polillas tienen cromosomas holocéntricos: el huso se ancla a lo largo de todo el cromosoma, así que los dos trozos de una ruptura conservan anclaje y los dos se heredan. Por eso el número de cromosomas puede cambiar en este grupo. Los puntos marcan anclajes al huso y su cantidad es esquemática.',
      mostAnimals: 'La mayoría de los animales',
      lepidoptera: 'Mariposas y polillas',
      onePointA: 'un anclaje',
      onePointB: 'en un punto',
      allAlongA: 'anclaje por',
      allAlongB: 'todo el cromosoma',
      lostPiece: 'se pierde el trozo sin anclaje',
      bothKept: 'se conservan los dos',
      footnote: 'Los puntos naranjas son el anclaje al huso. Por eso el número de cromosomas puede cambiar.',
      question: 'comparar ensamblajes a escala cromosómica',
    },
    introgression: {
      title: 'Un genoma, dos ancestros',
      desc: 'Los 21 cromosomas de una sola mariposa Heliconius elevatus, dibujados como barras grises. El gris es el 99 % del genoma heredado de una especie progenitora, Heliconius pardalinus. Los bloques de color son el 1 % restante, heredado de una segunda especie, Heliconius melpomene, por hibridación, y cada color marca qué controla ese fragmento de ADN. El bermellón marca el patrón de color, en los cromosomas 1, 5, 10, 12, 13, 15 y 18. El azul marca la forma del ala, en el cromosoma 20. El verde marca la planta hospedera, en el cromosoma 2. El morado marca las feromonas, en los cromosomas 19 y 20. Los bloques están repartidos por muchos cromosomas en vez de agrupados en uno solo. Las longitudes de los cromosomas y la posición de cada bloque dentro de un cromosoma son esquemáticas.',
      hook: 'Los 21 cromosomas de una mariposa Heliconius elevatus',
      legendGrey: 'Gris: el 99 % heredado de H. pardalinus.',
      legendColour: 'Color: el 1 % heredado de H. melpomene, identificado por rasgo:',
      traitColour: 'patrón de color',
      traitWing: 'forma del ala',
      traitPlant: 'planta hospedera',
      traitScent: 'feromonas',
      outcome: 'Ese 1 % está repartido por el genoma y ayuda a distinguir a H. elevatus.',
      question: 'comparar ensamblajes a escala cromosómica',
    },
  },
} as const;

const c = copy[locale];
const k = c[kind];
const introgressionChromosomes = Array.from({ length: 21 }, (_, index) => {
  const number = index + 1;
  const traits: string[] = [];
  if ([1, 5, 10, 12, 13, 15, 18].includes(number)) traits.push('pattern');
  if (number === 2) traits.push('plant');
  if (number === 19) traits.push('scent');
  if (number === 20) traits.push('wing', 'scent');
  return { number, traits, row: Math.floor(index / 7), column: index % 7 };
});
const mobileSteps: readonly string[] = kind === 'chromosome'
  ? [
      `${c.chromosome.mostAnimals}: ${c.chromosome.onePointA} ${c.chromosome.onePointB}`,
      c.chromosome.lostPiece,
      `${c.chromosome.lepidoptera}: ${c.chromosome.allAlongA} ${c.chromosome.allAlongB}`,
      c.chromosome.bothKept,
    ]
  : [
      c.introgression.legendGrey,
      c.introgression.legendColour,
      `${c.introgression.traitColour} · ${c.introgression.traitWing} · ${c.introgression.traitPlant} · ${c.introgression.traitScent}`,
      c.introgression.outcome,
    ];
---

<figure
  id={id}
  class="concept-diagram"
  data-kind={kind}
  data-context={context}
  data-concept-diagram
  data-label-replay={c.replay}
  data-duration-ms="5000"
  data-static={kind === 'introgression' ? 'true' : undefined}
  aria-busy="false"
>
  <figcaption class="concept-heading">
    <span class="concept-title-group">
      <span class="concept-kicker">{c.conceptual}</span>
      <strong>{k.title}</strong>
    </span>
    {kind === 'chromosome' && (
      <button type="button" class="concept-play" data-concept-play>
        <span class="play-icon" aria-hidden="true">▶</span>
        <span data-concept-play-label>{c.play}</span>
      </button>
    )}
  </figcaption>

  <svg class="concept-svg" viewBox={kind === 'chromosome' ? '0 0 600 266' : '0 0 600 382'} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{k.title}</title>
    <desc id={`${id}-desc`}>{k.desc}</desc>
    <defs>
      <marker id={`${id}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" class="arrowhead" />
      </marker>
      <marker id={`${id}-phylo-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" class="introgression-arrowhead" />
      </marker>
      <g id={`${id}-butterfly`}>
        <path d="M-2 -1 C-6 -12 -18 -12 -17 -2 C-16 5 -9 8 -2 4 Z" class="butterfly-wing" />
        <path d="M2 -1 C6 -12 18 -12 17 -2 C16 5 9 8 2 4 Z" class="butterfly-wing" />
        <path d="M-2 3 C-8 3 -13 8 -9 11 C-5 13 -2 8 0 5 Z" class="butterfly-wing butterfly-wing--hind" />
        <path d="M2 3 C8 3 13 8 9 11 C5 13 2 8 0 5 Z" class="butterfly-wing butterfly-wing--hind" />
        <path d="M0 -6 V8 M0 -5 C-2 -9 -5 -10 -7 -10 M0 -5 C2 -9 5 -10 7 -10" class="butterfly-body" />
      </g>
    </defs>

    {kind === 'chromosome' && (
      <g class="diagram-scene chromosome-scene">
        {/* Most animals: a single anchor point, so a break loses one piece. */}
        <text x="0" y="18" class="chr-head">{c.chromosome.mostAnimals}</text>
        <text x="0" y="60" class="chr-tag">{c.chromosome.onePointA}</text>
        <text x="0" y="76" class="chr-tag">{c.chromosome.onePointB}</text>

        <path d="M176 42 H263 V68 H176 A13 13 0 0 1 163 55 A13 13 0 0 1 176 42 Z" class="chr-body" />
        <circle cx="213" cy="55" r="7" class="chr-anch" />
        <g class="chr-lost">
          <path d="M263 42 H350 A13 13 0 0 1 363 55 A13 13 0 0 1 350 68 H263 Z" class="chr-body chr-lost-body" />
        </g>
        <rect x="259" y="43" width="8" height="24" class="chr-seam chr-seam--a" />
        <path d="M263 36 V74" class="chr-cut" />
        <text x="345" y="100" class="chr-grey chr-say" text-anchor="middle">{c.chromosome.lostPiece}</text>

        <path d="M0 128 H600" class="chr-rule" />

        {/* Butterflies and moths: anchors along the whole chromosome, so both
            pieces of the same break keep an anchor and both are inherited. */}
        <text x="0" y="158" class="chr-head">{c.chromosome.lepidoptera}</text>
        <text x="0" y="200" class="chr-tag">{c.chromosome.allAlongA}</text>
        <text x="0" y="216" class="chr-tag">{c.chromosome.allAlongB}</text>

        <g class="chr-fis-l">
          <path d="M176 182 H263 V208 H176 A13 13 0 0 1 163 195 A13 13 0 0 1 176 182 Z" class="chr-body" />
          <g class="chr-anch">
            <circle cx="177" cy="195" r="5" /><circle cx="197" cy="195" r="5" />
            <circle cx="217" cy="195" r="5" /><circle cx="237" cy="195" r="5" />
            <circle cx="257" cy="195" r="5" />
          </g>
        </g>
        <g class="chr-fis-r">
          <path d="M263 182 H350 A13 13 0 0 1 363 195 A13 13 0 0 1 350 208 H263 Z" class="chr-body" />
          <g class="chr-anch">
            <circle cx="269" cy="195" r="5" /><circle cx="289" cy="195" r="5" />
            <circle cx="309" cy="195" r="5" /><circle cx="329" cy="195" r="5" />
            <circle cx="349" cy="195" r="5" />
          </g>
        </g>
        <rect x="259" y="183" width="8" height="24" class="chr-seam chr-seam--b" />
        <path d="M263 176 V214" class="chr-cut" />
        <text x="390" y="200" class="chr-out chr-say">{c.chromosome.bothKept}</text>

        <text x="0" y="252" class="chr-note">{c.chromosome.footnote}</text>
      </g>
    )}
    {kind === 'introgression' && (
      <g class="diagram-scene introgression-scene">
        <text x="0" y="20" class="ig-hook">{c.introgression.hook}</text>
        <text x="0" y="48" class="ig-key">{c.introgression.legendGrey}</text>
        <text x="0" y="71" class="ig-key">{c.introgression.legendColour}</text>

        <g class="ig-legend">
          <rect x="0" y="91" width="20" height="12" rx="4" class="ig-sw ig-sw--pattern" />
          <text x="29" y="102" class="ig-key">{c.introgression.traitColour}</text>
          <rect x="300" y="91" width="20" height="12" rx="4" class="ig-sw ig-sw--wing" />
          <text x="329" y="102" class="ig-key">{c.introgression.traitWing}</text>
          <rect x="0" y="116" width="20" height="12" rx="4" class="ig-sw ig-sw--plant" />
          <text x="29" y="127" class="ig-key">{c.introgression.traitPlant}</text>
          <rect x="300" y="116" width="20" height="12" rx="4" class="ig-sw ig-sw--scent" />
          <text x="329" y="127" class="ig-key">{c.introgression.traitScent}</text>
        </g>

        <g class="ig-genome">
          {introgressionChromosomes.map((chromosome) => {
            // Keep the first outline inside the SVG view box; strokes centred
            // exactly on x=0 lose their outer half to view-box clipping.
            const x = 10 + chromosome.column * 82;
            const y = 140 + chromosome.row * 74;
            return (
              <g>
                <rect x={x} y={y} width="24" height="54" rx="10" class="ig-chr" />
                {chromosome.traits.map((trait, traitIndex) => (
                  <rect
                    x={x}
                    y={y + 10 + traitIndex * 24}
                    width="24"
                    height="10"
                    rx="4"
                    class={`ig-isl ig-isl--${trait}`}
                  />
                ))}
                <text x={x + 12} y={y + 70} class="ig-num">{chromosome.number}</text>
              </g>
            );
          })}
        </g>

        <text x="0" y="374" class="chr-out ig-say">{c.introgression.outcome}</text>
      </g>
    )}







  </svg>

  <ol class="concept-mobile-flow" aria-label={k.title}>
    {mobileSteps.map((step, index) => (
    <li data-mobile-step>
      <span class="mobile-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <span>{step}</span>
    </li>
    ))}
  </ol>

</figure>

<style>
  /* ---- introgression ---- */
  .ig-chr  { fill: var(--bg-inset); stroke: var(--text-faint); stroke-width: 1.2; }
  .ig-hook { font-family: var(--font-body); font-size: 17px; font-weight: 600; fill: var(--text-strong); }
  .ig-key  { font-family: var(--font-body); font-size: 17px; fill: var(--text-muted); }

  /* Colour carries which trait a block controls. Okabe-Ito hues, per-mode
     values in tokens.css. Colour is never the only channel: every swatch
     sits beside its label, and the mobile fallback names each trait. */
  .ig-isl--pattern, .ig-sw--pattern { fill: var(--trait-pattern); }
  .ig-isl--wing,    .ig-sw--wing    { fill: var(--trait-wing); }
  .ig-isl--plant,   .ig-sw--plant   { fill: var(--trait-plant); }
  .ig-isl--scent,   .ig-sw--scent   { fill: var(--trait-scent); }
  .ig-num  { font-family: var(--font-mono); font-size: 14px; fill: var(--text-faint); text-anchor: middle; }

  .concept-diagram {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }
  .concept-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-s);
    padding: var(--space-s) var(--space-m);
    color: var(--text-strong);
    font-size: var(--step--1);
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--bg-panel) 76%, transparent);
  }
  .concept-title-group {
    display: grid;
    gap: 0.18rem;
    min-width: min(100%, 15rem);
  }
  .concept-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .concept-heading strong {
    display: block;
    font-weight: 620;
    font-size: var(--step-0);
    line-height: 1.25;
  }
  .concept-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.45rem;
    padding: 0.52rem 0.82rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 12%, var(--bg-panel));
    color: var(--accent-strong);
    font: 650 var(--step--1)/1.1 var(--font-body);
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .concept-play:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
  }
  .concept-play:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .play-icon {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg-panel);
    font-size: 0.55rem;
    line-height: 1;
    text-indent: 0.08rem;
  }
  .concept-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 12.5rem;
    color: var(--text-muted);
    padding-inline: var(--space-xs);
  }
  .group-label,
  .footer-label,
  .node-label,
  .micro-label {
    font-family: var(--font-mono);
    fill: var(--text-muted);
    text-anchor: middle;
  }
  .group-label { font-size: 12px; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; fill: var(--accent-strong); }
  .node-label { font-size: 10.5px; }
  .micro-label { font-size: 9px; fill: var(--text-faint); }
  .footer-label { font-size: 11px; fill: var(--text-faint); }
  .flow,
  .relation,
  .icon-line {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .relation { stroke-dasharray: 5 5; stroke: var(--accent); }
  .arrowhead { fill: var(--accent); }
  .introgression-arrowhead { fill: var(--signal); }
  .chromosome-segment { opacity: 0.94; }
  .chromosome-segment--orange { fill: var(--accent); }
  .chromosome-segment--yellow { fill: var(--highlight); }
  .chromosome-outline {
    fill: none;
    stroke: color-mix(in oklab, var(--text-strong) 54%, transparent);
    stroke-width: 1.2;
  }
  .breakpoint-line {
    fill: none;
    stroke: var(--bg-panel);
    stroke-width: 3;
    stroke-dasharray: 3 2;
  }
  .new-end {
    fill: none;
    stroke: var(--highlight-strong);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .fusion-junction {
    fill: none;
    stroke: var(--bg-panel);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .gene-flow-divider {
    fill: none;
    stroke: var(--hairline);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }
  .lineage-path {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lineage-trunk,
  .homogenised-lineage { stroke: var(--text-muted); }
  .early-split-branch--dark,
  .early-merge-branch--dark,
  .late-split-branch--recipient,
  .late-tip-branch--recipient,
  .hybrid-lineage-branch { stroke: var(--c-burnt-700); }
  .early-split-branch--pale,
  .early-merge-branch--pale,
  .late-split-branch--donor,
  .late-tip-branch--donor { stroke: var(--c-ochre-600); }
  .lineage-node {
    fill: var(--bg-panel);
    stroke: var(--text-strong);
    stroke-width: 2;
  }
  .butterfly-wing {
    fill: currentColor;
    stroke: var(--text-strong);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }
  .butterfly-wing--hind { opacity: 0.78; }
  .butterfly-body {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .lineage-butterfly--ancestor { color: var(--text-muted); }
  .lineage-butterfly--dark { color: var(--c-burnt-700); }
  .lineage-butterfly--pale { color: var(--c-ochre-500); }
  :global([data-mode='dark']) .early-split-branch--dark,
  :global([data-mode='dark']) .early-merge-branch--dark,
  :global([data-mode='dark']) .late-split-branch--recipient,
  :global([data-mode='dark']) .late-tip-branch--recipient,
  :global([data-mode='dark']) .hybrid-lineage-branch { stroke: var(--c-burnt-300); }
  :global([data-mode='dark']) .early-split-branch--pale,
  :global([data-mode='dark']) .early-merge-branch--pale,
  :global([data-mode='dark']) .late-split-branch--donor,
  :global([data-mode='dark']) .late-tip-branch--donor { stroke: var(--c-ochre-300); }
  :global([data-mode='dark']) .lineage-butterfly--dark { color: var(--c-burnt-300); }
  :global([data-mode='dark']) .lineage-butterfly--pale { color: var(--c-ochre-300); }
  .gene-flow-link {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .early-gene-flow { stroke-dasharray: 5 5; }
  .late-introgression-link { stroke-width: 2.7; }
  .trait-token-shape,
  .trait-mark {
    fill: var(--signal);
    stroke: var(--bg-panel);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .trait-mark--hybrid { stroke-width: 1.8; }
  .gene-flow-label {
    fill: var(--text-strong);
    font-weight: 650;
  }
  .introgression-note { fill: var(--text-muted); }
  .connectivity-scene .micro-label,
  .connectivity-scene .panel-outcome {
    paint-order: stroke fill;
    stroke: var(--bg-panel);
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }
  .final-state-label {
    fill: var(--text-strong);
    font-size: 10px;
    font-weight: 750;
  }
  .connectivity-scene .final-state-label { stroke-width: 4.5px; }
  .hybrid-species-label { fill: var(--accent-strong); }
  .panel-outcome {
    fill: var(--text-muted);
    font-size: 9px;
    font-weight: 600;
  }
  .signal-dot { fill: var(--highlight); }
  .workflow-node {
    fill: var(--bg-panel);
    stroke: var(--hairline-strong);
    stroke-width: 1.5;
  }
  .workflow-node--focus { stroke: var(--accent); }
  .icon-line--strong { stroke: var(--accent-strong); stroke-width: 3; }
  .sample-node {
    fill: color-mix(in oklab, var(--accent) 16%, var(--bg-panel));
    stroke: var(--accent);
    stroke-width: 2;
  }
  .sample-node--alt {
    fill: color-mix(in oklab, var(--highlight) 18%, var(--bg-panel));
    stroke: var(--highlight-strong);
  }
  .question-node {
    fill: var(--bg-panel);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .question-mark {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 650;
    fill: var(--accent-strong);
    text-anchor: middle;
  }
  .event-ring {
    fill: color-mix(in oklab, var(--highlight) 12%, transparent);
    stroke: var(--highlight-strong);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .split-mark,
  .join-mark {
    fill: none;
    stroke: var(--highlight-strong);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* ── Chromosome break + W-fusion figures ──────────────────────────────
     Body face rather than mono: these carry sentence-length labels, and the
     Spanish strings run ~25% longer than the English ones. */
  .chr-head { font-family: var(--font-body); font-size: 15px; font-weight: 600; fill: var(--text-strong); }
  .chr-tag  { font-family: var(--font-body); font-size: 13px; fill: var(--text-muted); }
  .chr-out  { font-family: var(--font-body); font-size: 15px; font-weight: 600; fill: var(--accent); }
  .chr-grey { font-family: var(--font-body); font-size: 14px; font-weight: 500; fill: var(--text-faint); }
  .chr-note { font-family: var(--font-body); font-size: 12px; fill: var(--text-faint); }
  .chr-rule { fill: none; stroke: var(--hairline); stroke-width: 1; }
  .chr-body { fill: var(--bg-inset); stroke: var(--text-strong); stroke-width: 2; }
  .chr-anch { fill: var(--accent); }
  .chr-cut  { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 4 4; opacity: 0; }
  .chr-seam { fill: var(--bg-inset); opacity: 0; }
  .wf-who   { font-family: var(--font-body); font-size: 14px; font-weight: 500; fill: var(--text-muted); }
  .wf-chr   { fill: var(--bg-inset); stroke: var(--text-strong); stroke-width: 2; }
  .wf-w     { fill: var(--accent); stroke: var(--accent-strong); stroke-width: 2; }
  .wf-w--butt { stroke: none; }
  .wf-glyph { font-family: var(--font-body); font-size: 13px; font-weight: 600; fill: var(--text-strong); text-anchor: middle; }
  .wf-glyph--on-accent { fill: var(--bg-raised); }
  .wf-mini { font-family: var(--font-body); font-size: 11px; font-weight: 600; fill: var(--text-strong); text-anchor: middle; }
  .wf-mini--on-accent { fill: var(--bg-raised); }

  /* ── Introgression karyotype ──────────────────────────────────────────
     21 chromosomes drawn equal: lengths are schematic, and so is the
     position of each island within its chromosome. Only the CHROMOSOME
     assignments are from the source. */
  /* The legend is the whole point of this figure being standalone: without
     it, orange is just a colour and the reader has to infer from the prose
     that it means "DNA from a second species". */

  /* ── Mimicry: one pattern, two possible routes ─────────────────────── */
  .mim-body   { fill: var(--text-faint); }
  .mim-wing   { fill: var(--text-faint); opacity: 0.4; }
  .mim-band   { fill: var(--accent); }
  .mim-branch { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .mim-mark   { fill: var(--accent); }
  .mim-rise   { fill: none; stroke: var(--accent); stroke-width: 1.4; }
  .mim-cross  { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .mim-label  { text-anchor: middle; }
  .wf-membrane { fill: none; stroke: var(--hairline-strong); stroke-width: 1.5; }
  .wf-split { fill: none; stroke: var(--text-faint); stroke-width: 1.4; }
  .wf-sex { font-family: var(--font-body); font-size: 21px; font-weight: 500; fill: var(--text-faint); text-anchor: middle; }
  .wf-sex--female { fill: var(--accent); }

  /* Resting state IS the finished explanation, so reduced motion and a reader
     who never presses play both get the complete result. */
  .chr-lost      { transform: translateX(40px); opacity: 0.34; }
  .chr-lost-body { stroke-dasharray: 5 5; }
  .chr-fis-l     { transform: translateX(-10px); }
  .chr-fis-r     { transform: translateX(10px); }
  .wf-in         { opacity: 0; }
  .wf-in-w       { transform: translateX(26px); }
  .wf-in-a       { transform: translateX(-10px); }
  /* eggs rest where they end up: emerged from the mother cell and separated */
  .wf-egg-l      { transform: translate(0, 0); }
  .wf-egg-r      { transform: translate(0, 0); }

  @keyframes chr-cut-flash { 0%, 11% { opacity: 0; } 17%, 35% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes chr-seam-out  { 0%, 11% { opacity: 1; } 20%, 100% { opacity: 0; } }
  @keyframes chr-drift     { 0%, 17% { transform: translateX(0); opacity: 1; } 48%, 100% { transform: translateX(40px); opacity: 0.34; } }
  @keyframes chr-dash-in   { 0%, 35% { stroke-dasharray: 0 0; } 52%, 100% { stroke-dasharray: 5 5; } }
  @keyframes chr-part-l    { 0%, 17% { transform: translateX(0); } 48%, 100% { transform: translateX(-10px); } }
  @keyframes chr-part-r    { 0%, 17% { transform: translateX(0); } 48%, 100% { transform: translateX(10px); } }
  @keyframes chr-say       { 0%, 55% { opacity: 0; } 70%, 100% { opacity: 1; } }
  @keyframes wf-close-w    { 0%, 12% { transform: translateX(0); } 30%, 100% { transform: translateX(26px); } }
  @keyframes wf-close-a    { 0%, 12% { transform: translateX(0); } 30%, 100% { transform: translateX(-10px); } }
  @keyframes wf-in-out     { 0%, 33.9% { opacity: 1; } 34%, 100% { opacity: 0; } }
  @keyframes wf-neo-in     { 0%, 33.9% { opacity: 0; } 34%, 100% { opacity: 1; } }
  @keyframes wf-cell-in    { 0%, 38% { opacity: 0; } 48%, 100% { opacity: 1; } }
  @keyframes wf-split-in   { 0%, 54% { opacity: 0; } 66%, 100% { opacity: 1; } }
  /* Each egg starts inside the mother cell and moves out to its own place, so
     the reader sees the two products separating rather than appearing. */
  @keyframes wf-egg-out-l  { 0%, 50% { opacity: 0; transform: translate(115px, -81px); } 60% { opacity: 1; } 80%, 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes wf-egg-out-r  { 0%, 50% { opacity: 0; transform: translate(-115px, -81px); } 60% { opacity: 1; } 80%, 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes wf-sym-in     { 0%, 78% { opacity: 0; } 88%, 100% { opacity: 1; } }
  /* the islands appear one after another, so the reader watches the 1% land
     on chromosome after chromosome rather than seeing it all at once */
  @keyframes ig-land       { 0%, 18% { opacity: 0; transform: scaleY(0.2); } 34%, 100% { opacity: 1; transform: scaleY(1); } }
  @keyframes ig-genome-in  { 0% { opacity: 0.25; } 16%, 100% { opacity: 1; } }
  @keyframes ig-say-in     { 0%, 74% { opacity: 0; } 86%, 100% { opacity: 1; } }
  @keyframes mim-rise-in   { 0%, 30% { opacity: 0; } 46%, 100% { opacity: 1; } }
  @keyframes mim-cross-in  { 0%, 52% { opacity: 0; } 70%, 100% { opacity: 1; } }
  @keyframes mim-moved-in  { 0%, 62% { opacity: 0; } 76%, 100% { opacity: 1; } }
  @keyframes wf-say-in     { 0%, 84% { opacity: 0; } 94%, 100% { opacity: 1; } }

  .concept-diagram.is-playing .chr-cut       { animation: chr-cut-flash 4.6s ease-in-out both; }
  .concept-diagram.is-playing .chr-seam      { animation: chr-seam-out  4.6s linear both; }
  .concept-diagram.is-playing .chr-lost      { animation: chr-drift     4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .chr-lost-body { animation: chr-dash-in   4.6s linear both; }
  .concept-diagram.is-playing .chr-fis-l     { animation: chr-part-l    4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .chr-fis-r     { animation: chr-part-r    4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .chr-say       { animation: chr-say       4.6s ease-out both; }
  .concept-diagram.is-playing .wf-in-w       { animation: wf-close-w 4.6s var(--ease-settle) both, wf-in-out 4.6s linear both; }
  .concept-diagram.is-playing .wf-in-a       { animation: wf-close-a 4.6s var(--ease-settle) both, wf-in-out 4.6s linear both; }
  .concept-diagram.is-playing .wf-neo        { animation: wf-neo-in 4.6s linear both; }
  .concept-diagram.is-playing .wf-cell       { animation: wf-cell-in 4.6s ease-out both; }
  .concept-diagram.is-playing .wf-split      { animation: wf-split-in 4.6s ease-out both; }
  .concept-diagram.is-playing .wf-egg-l      { animation: wf-egg-out-l 4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .wf-egg-r      { animation: wf-egg-out-r 4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .wf-sym        { animation: wf-sym-in 4.6s ease-out both; }
  .concept-diagram.is-playing .ig-genome     { animation: ig-genome-in 4.6s ease-out both; }
  .concept-diagram.is-playing .mim-rise      { animation: mim-rise-in 4.6s ease-out both; }
  .concept-diagram.is-playing .mim-cross     { animation: mim-cross-in 4.6s ease-out both; }
  .concept-diagram.is-playing .mim-mark--moved { animation: mim-moved-in 4.6s var(--ease-settle) both; }
  .concept-diagram.is-playing .mim-say       { animation: ig-say-in 4.6s ease-out both; }
  .concept-diagram.is-playing .ig-say        { animation: ig-say-in 4.6s ease-out both; }
  .concept-diagram.is-playing .ig-isl--1-0 { animation: ig-land 4.6s 0.00s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--2-0 { animation: ig-land 4.6s 0.06s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--5-0 { animation: ig-land 4.6s 0.12s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--10-0 { animation: ig-land 4.6s 0.18s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--12-0 { animation: ig-land 4.6s 0.24s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--13-0 { animation: ig-land 4.6s 0.30s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--15-0 { animation: ig-land 4.6s 0.36s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--18-0 { animation: ig-land 4.6s 0.42s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--19-0 { animation: ig-land 4.6s 0.48s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--20-0 { animation: ig-land 4.6s 0.54s var(--ease-settle) both; }
  .concept-diagram.is-playing .ig-isl--20-1 { animation: ig-land 4.6s 0.60s var(--ease-settle) both; }
  .concept-diagram.is-playing .wf-say        { animation: wf-say-in 4.6s ease-out both; }

  /* The final scientific state is visible before and after playback. Motion
     appears only after the visitor explicitly presses the play control. */
  .concept-diagram.is-playing .play-icon { animation: play-orbit 900ms ease-in-out infinite; }
  .concept-diagram.is-playing .process-line,
  .concept-diagram.is-playing .workflow-link,
  .concept-diagram.is-playing .relation { stroke-dasharray: 10 8; }

  /* Connectivity timeline grows from ancestral bases to descendant tips, with
     deliberate pauses at the split, gene-flow event and final outcome. */
  .concept-diagram.is-playing .early-ancestor,
  .concept-diagram.is-playing .late-ancestor { animation: lineage-ancestor-focus 650ms 0s var(--ease-settle) both; }
  .concept-diagram.is-playing .early-lineage-trunk,
  .concept-diagram.is-playing .late-lineage-trunk { animation: lineage-path-draw 550ms 350ms ease-out both; }
  .concept-diagram.is-playing .early-divergence-node,
  .concept-diagram.is-playing .late-divergence-node { animation: lineage-stage-emerge 420ms 760ms var(--ease-settle) both; }
  .concept-diagram.is-playing .early-split-branch,
  .concept-diagram.is-playing .late-split-branch { animation: lineage-path-draw 750ms 1.0s ease-out both; }
  .concept-diagram.is-playing .early-midpoint-node,
  .concept-diagram.is-playing .donor-midpoint-node,
  .concept-diagram.is-playing .early-lineage-glyphs,
  .concept-diagram.is-playing .incipient-label { animation: lineage-stage-emerge 500ms 1.58s var(--ease-settle) both; }
  .concept-diagram.is-playing .early-gene-flow,
  .concept-diagram.is-playing .late-introgression-link { animation: gene-flow-draw 620ms 2.3s ease-out both; }
  .concept-diagram.is-playing .gene-flow-label,
  .concept-diagram.is-playing .introgression-note { animation: stage-label-focus 520ms 2.3s ease-out both; }
  .concept-diagram.is-playing .late-introgression-token { animation: hybrid-allele-cross 900ms 2.48s ease-in-out both; }
  .concept-diagram.is-playing .early-merge-branch { animation: lineage-path-draw 780ms 3.45s ease-out both; }
  .concept-diagram.is-playing .hybrid-origin-node { animation: event-pop 520ms 3.4s var(--ease-settle) both; }
  .concept-diagram.is-playing .late-tip-branch,
  .concept-diagram.is-playing .hybrid-lineage-branch { animation: lineage-path-draw 850ms 3.82s ease-out both; }
  .concept-diagram.is-playing .homogenised-lineage { animation: lineage-path-draw 560ms 4.3s ease-out both; }
  .concept-diagram.is-playing .homogenisation-node,
  .concept-diagram.is-playing .homogenised-butterfly,
  .concept-diagram.is-playing .recipient-butterfly,
  .concept-diagram.is-playing .donor-butterfly,
  .concept-diagram.is-playing .hybrid-butterfly,
  .concept-diagram.is-playing .trait-mark--hybrid { animation: lineage-stage-emerge 620ms 4.78s var(--ease-settle) both; }
  .concept-diagram.is-playing .final-state-label { animation: stage-label-focus 520ms 4.78s ease-out both; }
  .concept-diagram.is-playing .panel-outcome { animation: outcome-focus 720ms 5.5s ease-out both; }

  .concept-diagram.is-playing .workflow-stage--one { animation: group-focus 720ms 0s var(--ease-settle) both; }
  .concept-diagram.is-playing .workflow-link--one { animation: draw-link 650ms 620ms ease-out both; }
  .concept-diagram.is-playing .workflow-stage--two { animation: group-focus 720ms 1.05s var(--ease-settle) both; }
  .concept-diagram.is-playing .workflow-link--two { animation: draw-link 650ms 1.65s ease-out both; }
  .concept-diagram.is-playing .workflow-stage--three { animation: group-focus 720ms 2.1s var(--ease-settle) both; }
  .concept-diagram.is-playing .workflow-link--three { animation: draw-link 650ms 2.75s ease-out both; }
  .concept-diagram.is-playing .workflow-stage--four { animation: group-focus 820ms 3.2s var(--ease-settle) both; }

  .concept-diagram.is-playing .migration-sample--one { animation: stage-focus 720ms 0s var(--ease-settle) both; }
  .concept-diagram.is-playing .migration-sample--two { animation: stage-focus 720ms 280ms var(--ease-settle) both; }
  .concept-diagram.is-playing .migration-link--one,
  .concept-diagram.is-playing .migration-link--two { animation: route-flow 1.1s 820ms linear both; }
  .concept-diagram.is-playing .migration-question { animation: question-focus 900ms 1.7s var(--ease-settle) both; }
  .concept-diagram.is-playing .migration-link--three,
  .concept-diagram.is-playing .migration-link--four { animation: route-flow 1.1s 2.35s linear both; }
  .concept-diagram.is-playing .migration-result--one { animation: stage-focus 720ms 3.15s var(--ease-settle) both; }
  .concept-diagram.is-playing .migration-result--two { animation: stage-focus 720ms 3.45s var(--ease-settle) both; }

  .concept-evidence {
    margin: 0;
    padding: 0 var(--space-m) var(--space-m);
    color: var(--text-faint);
    font-size: var(--step--2);
    line-height: 1.5;
  }
  .concept-evidence a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 38%, transparent);
    text-underline-offset: 0.16em;
  }
  .concept-evidence a:hover { color: var(--accent-strong); }
  .concept-evidence a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @keyframes play-orbit { 50% { transform: rotate(180deg) scale(1.08); } 100% { transform: rotate(360deg); } }
  @keyframes draw-link { from { opacity: 0; stroke-dashoffset: 48; } to { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes event-pop { 0% { opacity: 0; transform: scale(0.25); } 65% { opacity: 1; transform: scale(1.25); } 100% { opacity: 0.85; transform: scale(1); } }
  @keyframes junction-flash { from { opacity: 0; stroke-width: 1; } 55% { opacity: 1; stroke-width: 5; } to { opacity: 1; stroke-width: 2.5; } }
  @keyframes group-focus { from { opacity: 0.12; filter: saturate(0.45) brightness(0.72); } 70% { opacity: 1; filter: saturate(1.25) brightness(1.12); } to { opacity: 1; filter: none; } }
  @keyframes route-flow { from { opacity: 0.15; stroke-dashoffset: 72; } to { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes lineage-ancestor-focus { from { opacity: 0.22; filter: saturate(0.35); } 70% { opacity: 1; filter: saturate(1.18); } to { opacity: 1; filter: none; } }
  @keyframes lineage-path-draw { from { opacity: 0; stroke-dasharray: 190; stroke-dashoffset: 190; } to { opacity: 1; stroke-dasharray: 190; stroke-dashoffset: 0; } }
  @keyframes lineage-stage-emerge { from { opacity: 0; filter: saturate(0.35); } 70% { opacity: 1; filter: saturate(1.22) brightness(1.08); } to { opacity: 1; filter: none; } }
  @keyframes gene-flow-draw { from { opacity: 0; stroke-dasharray: 180; stroke-dashoffset: 180; } to { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes hybrid-allele-cross { 0% { opacity: 0; transform: translateX(0); } 15% { opacity: 1; } 82% { opacity: 1; transform: translateX(-106px); } 100% { opacity: 0.35; transform: translateX(-106px); } }
  @keyframes trait-arrive { from { opacity: 0; transform: scale(0.2); } 70% { opacity: 1; transform: scale(1.28); } to { opacity: 1; transform: scale(1); } }
  @keyframes outcome-focus { from { opacity: 0.16; } 65% { opacity: 1; } to { opacity: 1; } }
  @keyframes stage-label-focus { from { opacity: 0; } to { opacity: 1; } }
  @keyframes stage-focus { from { opacity: 0.16; transform: scale(0.72); } 65% { opacity: 1; transform: scale(1.08); } to { opacity: 1; transform: scale(1); } }
  @keyframes question-focus { from { opacity: 0.18; transform: scale(0.5) rotate(-12deg); } 70% { opacity: 1; transform: scale(1.15) rotate(4deg); } to { opacity: 1; transform: scale(1) rotate(0); } }

  .chr-lost,
  .chr-fis-l,
  .chr-fis-r,
  .ig-isl,
  .wf-in,
  .wf-neo,
  .wf-egg-l,
  .wf-egg-r,
  .lineage-butterfly,
  .lineage-node,
  .early-lineage-glyphs,
  .late-introgression-token,
  .trait-mark--hybrid,
  .migration-sample,
  .migration-question,
  .migration-result {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Voucher scene: specimen → wings in an envelope (CAMID) + body in a tube (tube ID) → one record row. */
  .vch-body { fill: var(--text-muted); }
  .vch-antenna { fill: none; stroke: var(--text-muted); stroke-width: 2; stroke-linecap: round; }
  .vch-wing { fill: color-mix(in oklab, var(--accent) 22%, var(--bg-panel)); stroke: var(--accent); stroke-width: 1.5; }
  .vch-wing--hind { fill: color-mix(in oklab, var(--accent) 14%, var(--bg-panel)); }
  .vch-ocellus { fill: var(--highlight); stroke: var(--accent-strong); stroke-width: 1.5; }
  .vch-ghost-wings,
  .vch-ghost-body,
  .vch-net-sweep,
  .vch-collector-token { opacity: 0; }
  .vch-net-fill { opacity: 0.18; }
  .vch-net-depth,
  .vch-net-opening { fill: var(--text-muted); }
  .vch-net-rim { fill: none; stroke: var(--accent-strong); stroke-width: 3; }
  .vch-net-handle { fill: none; stroke: var(--accent-strong); stroke-width: 4; stroke-linecap: round; }
  .vch-forearm,
  .vch-hand {
    fill: color-mix(in oklab, var(--accent) 18%, var(--bg-panel));
    stroke: var(--text-strong);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .vch-fingers { fill: none; stroke: var(--text-muted); stroke-width: 1.15; stroke-linecap: round; }
  .vch-wristband,
  .vch-token-card { fill: var(--accent-strong); stroke: var(--bg-panel); stroke-width: 0.8; }
  .vch-wristband-label,
  .vch-token-label {
    font-family: var(--font-mono);
    font-size: 4.7px;
    font-weight: 750;
    letter-spacing: 0.02em;
    fill: var(--bg-panel);
    text-anchor: middle;
  }
  .vch-token-label { font-size: 5.2px; }
  .vch-env { fill: color-mix(in oklab, var(--accent) 6%, var(--bg-panel)); stroke: var(--hairline-strong); stroke-width: 1.5; }
  .vch-env-flap { fill: none; stroke: var(--hairline-strong); stroke-width: 1.2; }
  .vch-env-wings { fill: color-mix(in oklab, var(--accent) 30%, var(--bg-panel)); }
  .vch-idtag { font-family: var(--font-mono); font-size: 8px; font-weight: 600; letter-spacing: 0.04em; fill: var(--accent-strong); text-anchor: middle; }
  .vch-idtag--sm { font-size: 6.5px; }
  .vch-cap { fill: var(--accent-strong); }
  .vch-tube { fill: color-mix(in oklab, var(--accent) 7%, var(--bg-panel)); stroke: var(--hairline-strong); stroke-width: 1.5; }
  .vch-label { fill: var(--text-strong); opacity: 0.88; }
  .vch-barcode { fill: none; stroke: var(--bg-panel); stroke-width: 1.4; }
  .vch-barcode--row { fill: none; stroke: var(--accent-strong); stroke-width: 1.3; }
  .vch-body-inside { fill: color-mix(in oklab, var(--accent) 42%, transparent); stroke: var(--accent); stroke-width: 1; }
  .vch-sheet { fill: var(--bg-panel); stroke: var(--hairline-strong); stroke-width: 1.5; }
  .vch-sheet-head { fill: color-mix(in oklab, var(--accent) 14%, transparent); }
  .vch-row-hit { fill: color-mix(in oklab, var(--accent) 20%, transparent); }
  .vch-grid { fill: none; stroke: var(--hairline-strong); stroke-width: 1; opacity: 0.5; }
  .vch-field-head,
  .vch-record-value {
    font-family: var(--font-mono);
    font-weight: 650;
    fill: var(--accent-strong);
    text-anchor: middle;
  }
  .vch-field-head { font-size: 5.2px; letter-spacing: 0.02em; }
  .vch-record-value { font-size: 6.4px; }
  .vch-record-more { font-size: 9px; letter-spacing: 0.08em; }
  .vch-cell { fill: none; stroke: var(--text-faint); stroke-width: 3; stroke-linecap: round; }
  .vch-flow { fill: none; stroke: var(--text-muted); stroke-width: 2; stroke-linecap: round; }
  .vch-flow--split { stroke: var(--hairline-strong); stroke-width: 1.5; stroke-dasharray: 3 4; opacity: 0.75; }

  .vch-wings-l,
  .vch-wings-r,
  .vch-ghost-wings,
  .vch-ghost-body,
  .vch-cap-group,
  .vch-env-wings,
  .vch-body-inside,
  .vch-row-hit,
  .vch-record-values,
  .vch-net-sweep,
  .vch-collector-token { transform-box: fill-box; transform-origin: center; }
  .vch-wings-l { transform-origin: right center; }
  .vch-wings-r { transform-origin: left center; }
  .vch-row-hit { transform-origin: left center; }

  .concept-diagram.is-playing .vch-flow--env,
  .concept-diagram.is-playing .vch-flow--tube { stroke-dasharray: 48; }
  /* 1. The collector sweeps the fully visible, side-view net across the specimen. */
  .concept-diagram.is-playing .vch-net-sweep { animation: net-catch 2.15s 0s ease-in-out both; }
  .concept-diagram.is-playing .vch-specimen-label { animation: specimen-label-reveal 500ms 1.7s ease-out both; }
  .concept-diagram.is-playing .vch-collector-token { animation: collector-to-record 2.5s 1.35s ease-in-out both; }
  /* 2. The specimen is opened and filed: wings → envelope, body → tube. */
  .concept-diagram.is-playing .voucher-scene .vch-wings-l { animation: wing-open 600ms 1.05s var(--ease-settle) both; }
  .concept-diagram.is-playing .voucher-scene .vch-wings-r { animation: wing-open 600ms 1.15s var(--ease-settle) both; }
  .concept-diagram.is-playing .vch-ghost-wings { animation: fly-wings 1.15s 1.15s ease-in-out both; }
  .concept-diagram.is-playing .vch-ghost-body { animation: fly-body 1.15s 1.2s ease-in-out both; }
  .concept-diagram.is-playing .vch-cap-group { animation: cap-open 1s 1.7s ease-in-out both; }
  .concept-diagram.is-playing .vch-envelope { animation: group-focus 700ms 2.05s var(--ease-settle) both; }
  .concept-diagram.is-playing .vch-env-wings { animation: event-pop 620ms 2.2s var(--ease-settle) both; }
  .concept-diagram.is-playing .vch-tube-group { animation: group-focus 700ms 2.2s var(--ease-settle) both; }
  .concept-diagram.is-playing .vch-body-inside { animation: event-pop 620ms 2.4s var(--ease-settle) both; }
  /* 3. Both identifiers converge on one record row. */
  .concept-diagram.is-playing .vch-flow--env { animation: draw-link 650ms 3.0s ease-out both; }
  .concept-diagram.is-playing .vch-flow--tube { animation: draw-link 650ms 3.2s ease-out both; }
  .concept-diagram.is-playing .vch-sheet-group { animation: group-focus 720ms 3.55s var(--ease-settle) both; }
  .concept-diagram.is-playing .voucher-scene .vch-row-hit { animation: row-mark 760ms 3.8s var(--ease-settle) both; }
  .concept-diagram.is-playing .voucher-scene .vch-record-values { animation: event-pop 620ms 4.05s var(--ease-settle) both; }

  @keyframes net-catch {
    0% { opacity: 0; transform: translateX(-30px); }
    10% { opacity: 1; }
    48%, 78% { opacity: 1; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(4px); }
  }
  @keyframes collector-to-record {
    0% { opacity: 0; transform: translate(0, 0) scale(1); }
    12% { opacity: 1; transform: translate(0, 0) scale(1); }
    22% { opacity: 1; transform: translate(18px, -5px) scale(0.96); }
    52%, 84% { opacity: 1; transform: translate(465px, -63px) scale(0.72); }
    100% { opacity: 0; transform: translate(465px, -63px) scale(0.72); }
  }
  @keyframes specimen-label-reveal { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes wing-open { from { opacity: 1; transform: scaleX(1); } 70% { opacity: 1; transform: scaleX(1.06); } to { opacity: 1; transform: scaleX(1); } }
  @keyframes fly-wings { 0% { opacity: 0; transform: translate(0, 0) scale(1); } 18% { opacity: 0.9; } 82% { opacity: 0.9; } 100% { opacity: 0; transform: translate(204px, -42px) scale(0.42); } }
  @keyframes fly-body { 0% { opacity: 0; transform: translate(0, 0) scale(1); } 18% { opacity: 0.9; } 82% { opacity: 0.9; } 100% { opacity: 0; transform: translate(204px, 36px) scale(0.5); } }
  @keyframes cap-open { 0% { transform: translateY(0); } 25%, 70% { transform: translateY(-12px); } 100% { transform: translateY(0); } }
  @keyframes row-mark { from { opacity: 0; transform: scaleX(0.15); } 70% { opacity: 1; transform: scaleX(1.03); } to { opacity: 1; transform: scaleX(1); } }
  /* The play label shortens to "Repetir" after the first play. In a wrapping
     flex header that stops the button wrapping, the header loses a row and the
     card jumps ~55px shorter mid-interaction. A grid puts the control on its
     own row whatever the label says, in either language. */
  [data-context='science'] .concept-heading {
    display: grid;
    justify-items: start;
  }
  [data-context='pilot'] .concept-heading { padding-block-start: var(--space-xs); }
  /* 600x266 viewBox: at ~30rem of column width the natural height is ~13.3rem,
     so the shared 12.5rem cap was shrinking these two and centring them in a
     much wider box. */
  /* These caps exist to stop a wide figure eating the viewport. They must
     stay ABOVE the height the container width implies, or the SVG scales
     down to satisfy the cap and preserveAspectRatio centres it, leaving
     dead space on both sides. Container max-width is set by the page. */
  [data-kind='chromosome'] .concept-svg { max-height: 22rem; }
  [data-kind='introgression'] .concept-svg {
    max-height: none;
    padding: var(--space-s) var(--space-m) var(--space-m);
  }
  /* 720x255 viewBox at the 46rem lone-figure width is ~16.3rem tall. */
  [data-context='pilot'] .concept-svg { max-height: 10.75rem; }
  .concept-mobile-flow { display: none; }
  @media (max-width: 34rem) {
    .concept-heading { display: grid; }
    .concept-play { width: 100%; }
    .concept-svg {
      display: block;
      width: 100%;
      max-height: none;
      padding: var(--space-xs) 0 0;
    }
    .concept-svg .group-label,
    .concept-svg .node-label,
    .concept-svg .footer-label { display: none; }
    .connectivity-scene .micro-label { display: none; }
    .connectivity-scene .final-state-label {
      display: block;
      font-size: 12px;
    }
    .concept-mobile-flow {
      display: grid;
      list-style: none;
      margin: 0;
      padding: var(--space-s) var(--space-m) var(--space-m);
    }
    .concept-mobile-flow li {
      position: relative;
      display: grid;
      grid-template-columns: 2.35rem minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xs);
      min-height: 3.25rem;
      color: var(--text);
      font-size: var(--step--1);
      line-height: 1.4;
    }
    .concept-mobile-flow li:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 1.08rem;
      top: 2.6rem;
      bottom: -0.65rem;
      width: 1px;
      background: var(--hairline-strong);
    }
    .mobile-step-number {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      border: 1px solid var(--accent);
      border-radius: 50%;
      background: var(--bg-panel);
      color: var(--accent-strong);
      font-family: var(--font-mono);
      font-size: var(--step--2);
      font-weight: 650;
    }
    .connectivity-mobile-outcomes {
      gap: var(--space-xs);
    }
    .connectivity-mobile-outcomes li {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 0.2rem;
      min-height: 0;
      padding: var(--space-s);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--accent) 5%, var(--bg-panel));
    }
    .connectivity-mobile-outcomes li:last-child {
      border-color: color-mix(in oklab, var(--accent) 55%, var(--hairline-strong));
    }
    .connectivity-mobile-outcomes li:not(:last-child)::after { display: none; }
    .connectivity-mobile-outcomes strong {
      color: var(--text-strong);
      font-size: var(--step-0);
      line-height: 1.2;
    }
    .connectivity-outcome-cue {
      color: var(--accent-strong);
      font: 650 var(--step--2)/1.2 var(--font-mono);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .concept-diagram.is-playing .concept-mobile-flow li {
      animation: mobile-step 620ms var(--ease-settle) both;
    }
    .concept-diagram.is-playing .concept-mobile-flow li:nth-child(2) { animation-delay: 900ms; }
    .concept-diagram.is-playing .concept-mobile-flow li:nth-child(3) { animation-delay: 1.8s; }
    .concept-diagram.is-playing .concept-mobile-flow li:nth-child(4) { animation-delay: 2.7s; }
    .concept-diagram.is-playing .concept-mobile-flow li:nth-child(5) { animation-delay: 3.5s; }
    @keyframes mobile-step {
      from { opacity: 0.28; transform: translateX(-0.6rem); }
      70% { opacity: 1; transform: translateX(0.18rem); }
      to { opacity: 1; transform: translateX(0); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .concept-play,
    .concept-play:hover { transition: none; transform: none; }
    .concept-diagram *,
    .concept-diagram *::before,
    .concept-diagram *::after { animation: none !important; }
  }
</style>

<script>
  const conceptTimers = new WeakMap<HTMLElement, number>();

  function initConceptDiagrams() {
    document.querySelectorAll<HTMLElement>('[data-concept-diagram]:not([data-static])').forEach((diagram) => {
      if (diagram.dataset.conceptInit === '1') return;
      diagram.dataset.conceptInit = '1';

      const button = diagram.querySelector<HTMLButtonElement>('[data-concept-play]');
      const label = diagram.querySelector<HTMLElement>('[data-concept-play-label]');
      if (!button || !label) return;

      button.addEventListener('click', () => {
        const runningTimer = conceptTimers.get(diagram);
        if (runningTimer !== undefined) window.clearTimeout(runningTimer);

        diagram.classList.remove('is-playing');
        // Restart the keyframe timeline when Replay is pressed.
        void diagram.offsetWidth;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          diagram.setAttribute('aria-busy', 'false');
          label.textContent = diagram.dataset.labelReplay ?? '';
          return;
        }

        diagram.classList.add('is-playing');
        diagram.setAttribute('aria-busy', 'true');
        label.textContent = diagram.dataset.labelReplay ?? '';

        const timer = window.setTimeout(() => {
          diagram.classList.remove('is-playing');
          diagram.setAttribute('aria-busy', 'false');
          label.textContent = diagram.dataset.labelReplay ?? '';
          conceptTimers.delete(diagram);
        }, Number(diagram.dataset.durationMs ?? 5000));
        conceptTimers.set(diagram, timer);
      });
    });
  }

  document.addEventListener('astro:page-load', initConceptDiagrams);
  initConceptDiagrams();
</script>
