            <path d="M4 6 C 30 6 40 20 31 32 C 22 41 8 32 4 20 Z" class="vch-wing vch-wing--hind" />
            <circle cx="27" cy="-6" r="4.5" class="vch-ocellus" />
          </g>
          {/* Transient parts that fly to their stores during playback. */}
          <g class="vch-ghost-wings">
            <path d="M-2 -3 C -20 -17 -30 -5 -24 6 C -20 13 -6 11 -2 3 Z" class="vch-wing" />
            <path d="M2 -3 C 20 -17 30 -5 24 6 C 20 13 6 11 2 3 Z" class="vch-wing" />
          </g>
          <rect x="-2.5" y="-12" width="5" height="24" rx="2.5" class="vch-body vch-ghost-body" />
        </g>

        {/* Collector: the net, hand and placeholder wristband remain entirely in frame. */}
        <g class="vch-net" transform="translate(86 90)">
          <g class="vch-net-sweep">
            {/* Side-view bag trails the rim so the net reads with depth. */}
            <g class="vch-net-fill">
              <path d="M21 -43 C5 -42 -14 -36 -31 -25 C-43 -17 -48 -6 -44 5 C-39 18 -21 26 -4 22 C9 19 18 10 25 -2 C20 -14 18 -30 21 -43 Z" class="vch-net-depth" />
              <ellipse cx="26" cy="-1" rx="20" ry="45" transform="rotate(-8 26 -1)" class="vch-net-opening" />
            </g>
            <ellipse cx="26" cy="-1" rx="20" ry="45" transform="rotate(-8 26 -1)" class="vch-net-rim" />
            <path d="M23 42 L-2 68" class="vch-net-handle" />
            <g class="vch-collector">
              <path d="M-52 62 H-24 C-18 62 -14 66 -12 72 L-18 83 H-52 Z" class="vch-forearm" />
              <rect x="-49" y="64" width="30" height="16" rx="3" class="vch-wristband" />
              <text x="-34" y="74.5" class="vch-wristband-label">{c.voucher.collector}</text>
              <path d="M-23 73 C-26 67 -23 60 -17 57 C-13 55 -9 57 -7 61 C-6 56 -2 54 2 56 C6 58 7 63 6 67 L9 65 C13 64 16 67 16 71 C16 75 13 77 9 78 L3 80 C0 85 -5 88 -11 87 C-17 86 -21 81 -23 73 Z" class="vch-hand" />
              <path d="M-16 61 C-11 61 -8 65 -8 69 M-9 59 C-4 60 -1 63 0 68 M-4 78 C1 74 5 73 10 74" class="vch-fingers" />
            </g>
          </g>
        </g>

        {/* A duplicate of the wristband label travels into the record. */}
        <g transform="translate(52 162)">
          <g class="vch-collector-token">
            <rect x="-16" y="-7" width="32" height="14" rx="3" class="vch-token-card" />
            <text x="0" y="2" class="vch-token-label">{c.voucher.collector}</text>
          </g>
        </g>

        {/* Wings stored in a labelled envelope carrying the CAMID. */}
        <g class="vch-envelope" transform="translate(290 48)">
          <rect x="-28" y="-19" width="56" height="40" rx="3" class="vch-env" />
          <path d="M-28 -19 L0 -3 L28 -19" class="vch-env-flap" />
