---
import { EVENTS, pick } from '../data/initiative';
import { localePath, type Locale } from '../i18n';
import { PILOT_INTRO } from '../data/pilot-call';
import Icon from './Icon.astro';

interface Props {
  readonly locale: Locale;
  readonly compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const funding = PILOT_INTRO[locale];
---

<ol class:list={['timeline-list', { 'timeline-list--compact': compact }]} role="list">
  <li class="timeline-item" id="event-colombia-funding">
    <div class="timeline-header">
      <time class="timeline-dates mono" datetime="2026-09-30">{funding.date}</time>
      <span class="timeline-name">{funding.call}</span>
    </div>
    <p class="timeline-location mono">{funding.deadline} · Colombia</p>
    <p class="timeline-summary">{funding.description}</p>
    <a class="text-link timeline-summary" href={localePath(locale, '/funding')}>{funding.funding}<Icon name="arrow-right" /></a>
  </li>
  {EVENTS.map((event) => (
    <li class="timeline-item" id={`event-${event.id}`}>
      <div class="timeline-header">
        <time class="timeline-dates mono">{pick(event.dates, locale)}</time>
        <span class="timeline-name">{pick(event.name, locale)}</span>
      </div>
      <p class="timeline-location mono">{pick(event.location, locale)}</p>
      <p class="timeline-summary">{pick(event.summary, locale)}</p>
    </li>
  ))}
</ol>

<style>
  .timeline-list {
    list-style: none;
    /* margin-top intentionally not reset — the page owns vertical rhythm
       via `.section > .container-wide > * + *` in global.css. A blanket
       `margin: 0` here ties that rule on specificity and wins on source
       order, which is what left this block flush against its heading. */
    margin-block-end: 0;
    margin-inline: 0;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .timeline-item {
    min-width: 0;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .timeline-item:last-child {
    border-bottom: none;
  }
  .timeline-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s);
  }
  .timeline-dates {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    letter-spacing: 0.04em;
    white-space: normal;
    flex-shrink: 0;
  }
  .timeline-name {
    font-size: var(--step-0);
    font-weight: 620;
    color: var(--text-strong);
    letter-spacing: -0.006em;
    line-height: 1.3;
  }
  .timeline-location {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .timeline-summary {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .timeline-list--compact {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .timeline-list--compact .timeline-item {
    padding: var(--space-m);
    border-bottom: 0;
  }
  .timeline-list--compact .timeline-item + .timeline-item {
    border-left: 1px solid var(--hairline);
  }
  @media (max-width: 64rem) {
    .timeline-list--compact {
      grid-template-columns: 1fr;
    }
    .timeline-list--compact .timeline-item {
      padding-inline: 0;
      border-bottom: 1px solid var(--hairline);
    }
    .timeline-list--compact .timeline-item + .timeline-item {
      border-left: 0;
    }
    .timeline-list--compact .timeline-item:last-child {
      border-bottom: 0;
    }
  }
</style>
