---
import Icon from './Icon.astro';
import { getDict, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const email = getDict(locale).participate.contact.email;
const es = locale === 'es';
---
<div class="email-contact" data-copy-email data-email={email} data-success={es ? 'Correo copiado al portapapeles.' : 'Email copied to clipboard.'} data-failure={es ? 'No se pudo copiar. Selecciona el correo y cópialo manualmente.' : 'Could not copy. Select the email and copy it manually.'}>
  <span class="email-address">{email}</span>
  <button class="btn email-copy-button" type="button" hidden aria-label={es ? `Copiar ${email}` : `Copy ${email}`}>
    <Icon name="copy" /><span>{email}</span>
  </button>
  <div class="email-toast" data-email-toast role="status" aria-live="polite" aria-atomic="true" hidden>
    <span class="toast-icon" aria-hidden="true"><Icon name="check" /></span>
    <span class="toast-content"><span data-email-message></span><span class="toast-email" data-email-fallback hidden>{email}</span></span>
    <button class="toast-dismiss" data-email-dismiss type="button" aria-label={es ? 'Cerrar confirmación' : 'Dismiss confirmation'}><Icon name="close" /></button>
  </div>
</div>
<script>
  const copyTimers = new Map<HTMLElement, number>();
  function hideToast(root: HTMLElement) {
    const toast = root.querySelector<HTMLElement>('[data-email-toast]');
    if (toast) {
      const restoreFocus = toast.contains(document.activeElement);
      toast.hidden = true;
      if (restoreFocus) root.querySelector<HTMLButtonElement>('.email-copy-button')?.focus({ preventScroll: true });
    }
    const timer = copyTimers.get(root);
    if (timer !== undefined) window.clearTimeout(timer);
    copyTimers.delete(root);
  }
  function showResult(root: HTMLElement, copied: boolean) {
    const toast = root.querySelector<HTMLElement>('[data-email-toast]');
    const message = root.querySelector<HTMLElement>('[data-email-message]');
    const fallback = root.querySelector<HTMLElement>('[data-email-fallback]');
    if (!toast || !message || !fallback) return;
    hideToast(root);
    toast.dataset.result = copied ? 'success' : 'failure';
    fallback.hidden = copied;
    message.textContent = '';
    toast.hidden = false;
    requestAnimationFrame(() => { message.textContent = (copied ? root.dataset.success : root.dataset.failure) ?? ''; });
    if (copied) copyTimers.set(root, window.setTimeout(() => hideToast(root), 5000));
  }
  function initCopyEmail() {
    document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach(root => {
      if (root.dataset.ready) return;
      const button = root.querySelector<HTMLButtonElement>('.email-copy-button');
      const dismiss = root.querySelector<HTMLButtonElement>('[data-email-dismiss]');
      const email = root.dataset.email;
      if (!button || !dismiss || !email) return;
      root.dataset.ready = 'true';
      button.hidden = false;
      dismiss.addEventListener('click', () => hideToast(root));
      root.addEventListener('keydown', event => { if (event.key === 'Escape') hideToast(root); });
      button.addEventListener('click', async () => {
        let copied = false;
        try {
          if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(email); copied = true; }
        } catch { /* Try the synchronous fallback below. */ }
        if (!copied) {
          const selection = document.createElement('textarea');
          selection.value = email;
          selection.readOnly = true;
          selection.style.cssText = 'position:fixed;left:-9999px;top:0;';
          document.body.append(selection);
          selection.select();
          try { copied = document.execCommand('copy'); } catch { copied = false; }
          selection.remove();
          button.focus({ preventScroll: true });
        }
        showResult(root, copied);
      });
    });
  }
  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
  document.addEventListener('astro:before-swap', () => {
    copyTimers.forEach(timer => window.clearTimeout(timer));
    copyTimers.clear();
  });
</script>
<style>
  .email-contact { max-width: 100%; }
  .email-address { color: var(--text-muted); overflow-wrap: anywhere; user-select: all; }
  [data-ready] > .email-address { display: none; }
  .email-copy-button { max-width: 100%; min-height: 44px; }
  .email-copy-button[hidden] { display: none; }
  .email-copy-button :global(svg) { flex: 0 0 auto; }
  .email-copy-button span { min-width: 0; overflow-wrap: anywhere; }
  .email-toast { position: fixed; z-index: 300; right: max(var(--space-m), env(safe-area-inset-right)); bottom: max(var(--space-m), env(safe-area-inset-bottom)); display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: var(--space-s); width: min(26rem, calc(100vw - 2 * var(--space-m))); padding: var(--space-s); color: var(--text); background: var(--bg-panel); border: 1px solid var(--hairline-strong); border-radius: var(--radius); box-shadow: 0 .5rem 1.5rem color-mix(in oklab, #000 22%, transparent); animation: toast-in 180ms cubic-bezier(.16, 1, .3, 1) both; }
  .email-toast[hidden] { display: none; }
  .email-toast[data-result='failure'] { grid-template-columns: minmax(0, 1fr) auto; }
  .email-toast[data-result='failure'] .toast-icon { display: none; }
  .toast-icon { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; color: var(--accent-strong); }
  .toast-icon :global(svg) { width: 1.1rem; height: 1.1rem; }
  .toast-content { min-width: 0; line-height: 1.45; }
  .toast-email { display: block; margin-top: var(--space-2xs); color: var(--text-strong); overflow-wrap: anywhere; user-select: all; }
  .toast-email[hidden] { display: none; }
  .toast-dismiss { display: grid; place-items: center; width: 44px; height: 44px; margin: -.65rem -.65rem -.65rem 0; padding: 0; border: 0; background: transparent; color: var(--text-muted); cursor: pointer; }
  .toast-dismiss:hover { color: var(--text-strong); }
  .toast-dismiss :global(svg) { width: 1rem; height: 1rem; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(.5rem); } }
  @media (prefers-reduced-motion: reduce) { .email-toast { animation: none; } }
  @media (max-width: 34rem) {
    .email-copy-button { width: 100%; justify-content: center; }
    .email-toast { right: var(--space-s); bottom: var(--space-s); width: calc(100vw - 2 * var(--space-s)); }
  }
</style>
