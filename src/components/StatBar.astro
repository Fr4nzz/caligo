---
import CardIcon, { type CardIconName } from './CardIcon.astro';

type MetricKind = 'participants' | 'facilities' | 'countries' | 'pilots';

interface Metric {
  readonly value: number | string;
  readonly label: string;
  readonly asOf?: string;
  readonly kind?: MetricKind;
}

interface Props {
  readonly metrics: readonly Metric[];
  readonly variant?: 'bar' | 'community-cards';
}

const { metrics, variant = 'bar' } = Astro.props;
const icons: Record<MetricKind, CardIconName> = { participants: 'people', facilities: 'facility', countries: 'globe', pilots: 'project' };
---

{metrics.length >= 2 && variant === 'community-cards' && (
  <ul class="metric-cards" role="list">
    {metrics.map((metric) => (
      <li class:list={['metric-card', { 'metric-card--lead': metric.kind === 'participants' }]}>
        <strong class="metric-card__value">{metric.value}</strong>
        <span class="metric-card__copy">
          <span class="metric-card__label">{metric.label}</span>
          {metric.asOf && <span class="metric-card__asof">{metric.asOf}</span>}
        </span>
        {metric.kind && <CardIcon name={icons[metric.kind]} class="metric-icon" />}
      </li>
    ))}
  </ul>
)}

{metrics.length >= 2 && variant === 'bar' && (
  <ul class="stat-bar" role="list">
    {metrics.map((metric) => (
      <li class="stat-item">
        <span class="stat-value">{metric.value}</span>
        <span class="stat-label mono">{metric.label}</span>
        {metric.asOf && <span class="stat-asof mono">{metric.asOf}</span>}
      </li>
    ))}
  </ul>
)}

<style>
  .metric-cards {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr));
    gap: .75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .metric-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .875rem;
    min-width: 0;
    min-height: 5rem;
    padding: 1.15rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-panel);
  }
  .metric-card--lead { background: color-mix(in oklab, var(--accent) 9%, var(--bg-panel)); border-color: var(--hairline-strong); }
  .metric-card :global(.metric-icon) { width: 1.75rem; height: 1.75rem; }
  .metric-card__value {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 450;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.05em;
    line-height: 1;
  }
  .metric-card--lead .metric-card__value { color: var(--accent-strong); }
  .metric-card__copy { min-width: 0; }
  .metric-card__label { display: block; color: var(--text-strong); font-size: .86rem; font-weight: 450; line-height: 1.45; }
  .metric-card__asof { display: block; margin-top: .375rem; color: var(--text-faint); font-size: .72rem; line-height: 1.4; }

  .stat-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
    list-style: none;
    margin: 0;
    padding: var(--space-m);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-panel);
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .stat-value {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 560;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.018em;
    line-height: 1;
  }
  .stat-label {
    color: var(--text-faint);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .stat-asof {
    color: var(--text-faint);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  @media (max-width: 48rem) {
    .metric-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.25rem; }
    .metric-card { padding: 1rem; grid-template-columns: auto minmax(0, 1fr); }
    .metric-card :global(.metric-icon) { display: none; }
  }
  @media (max-width: 25rem) {
    .metric-card { grid-template-columns: 1fr; gap: .5rem; }
  }
</style>
