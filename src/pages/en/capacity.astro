---
/*
  Legacy URL. /capacity/ predates the Network page and is kept alive so old
  inbound links resolve — but a visitor should land on the real page, not on
  a notice about how the site was reorganised. Redirect immediately; the
  visible body is a fallback for anyone whose browser blocks the refresh.
*/
import Base from '../../layouts/Base.astro';
import { getDict, localePath } from '../../i18n';

const locale = 'en' as const;
const t = getDict(locale);
const target = localePath(locale, '/network');
---

<Base
  locale={locale}
  title={`${t.network.title} | Caligo`}
  description={t.network.intro}
  page="/capacity"
  noindex
>
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <link rel="canonical" href={target} slot="head" />

  <section class="container-wide redirect-page">
    <h1>{t.network.title}</h1>
    <p class="lead">{t.network.intro}</p>
    <p class="redirect-cta">
      <a class="btn" href={target}>{t.nav.network}</a>
    </p>
  </section>
</Base>

<script is:inline define:vars={{ target }}>
  location.replace(target);
</script>

<style>
  .redirect-page {
    padding-block: var(--space-xl);
  }
  .redirect-page h1 {
    margin-top: 0;
    max-width: 22ch;
  }
  .redirect-page .lead {
    margin-top: var(--space-s);
    max-width: 56ch;
    color: var(--text-muted);
  }
  .redirect-cta {
    margin-top: var(--space-l);
  }
</style>
